.action-followup{margin:24rpx 0 0;padding:20rpx 22rpx;background:rgba(252,251,247,.72);border:1rpx solid var(--border);border-radius:var(--radius-md);color:var(--ink)}.action-followup.compact{margin-top:16rpx;padding:16rpx 18rpx;background:rgba(252,251,247,.48)}.action-followup-kicker{font-size:18rpx;letter-spacing:2rpx;color:var(--muted);line-height:1.5}.action-followup-copy{font-size:25rpx;line-height:1.75;margin-top:6rpx}.action-followup-primary{display:flex;justify-content:space-between;align-items:center;width:100%;margin:14rpx 0 0;padding:12rpx 0 0;background:transparent;border-top:1rpx solid var(--border);border-radius:0;text-align:left;color:#536c55;font-size:23rpx}.action-followup-primary text{font-size:30rpx;color:var(--gold)}.action-followup-actions{display:flex;gap:12rpx;margin-top:14rpx}.action-followup-actions button{flex:1;min-height:68rpx;margin:0;padding:12rpx 8rpx;border:1rpx solid var(--border);border-radius:999rpx;background:transparent;color:#53654f;font-size:21rpx}.action-followup-actions button:first-child{background:#e0e5d8;border-color:#9eaa91;color:#2f4c38}.action-followup-done{font-size:21rpx;color:#66745e;line-height:1.7;margin-top:10rpx}.action-followup-done button{display:inline;padding:0;background:transparent;color:#7b6b4f;font-size:21rpx;border-radius:0}
