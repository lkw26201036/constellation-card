<view wx:if="{{(card && card.id) || (action && action.id)}}" class="action-followup {{compact ? 'compact' : ''}}">
 <view class="action-followup-kicker">{{record ? (record.status === 'done' ? '已完成 · 留给自己的回应' : '留给自己的下一步') : '把灵感交给一件小事'}}</view>
 <view class="action-followup-copy">{{record ? (record.advice || record.title) : (card.advice || card.tip || '给今天留一个可以完成的小动作。')}}</view>
 <block wx:if="{{!record}}"><button class="action-followup-primary" bindtap="save">收下这一步 <text>→</text></button></block>
 <block wx:elif="{{record.status === 'saved'}}"><view class="action-followup-actions"><button bindtap="changeStatus" data-status="done">标记已完成</button><button bindtap="changeStatus" data-status="later">稍后再做</button></view></block>
 <block wx:elif="{{record.status === 'later'}}"><view class="action-followup-actions"><button bindtap="changeStatus" data-status="done">现在完成</button><button bindtap="changeStatus" data-status="saved">先收着</button></view></block>
 <block wx:else><view class="action-followup-done">已完成于 {{record.completedLabel}} · <button bindtap="changeStatus" data-status="later">改为稍后再做</button></view></block>
</view>
