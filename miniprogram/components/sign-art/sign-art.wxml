<view class="sign-scene" aria-hidden="true"><view class="sky"><view wx:for="{{art.lines}}" wx:key="index" class="line" style="left:{{item.x}}rpx;top:{{item.y}}rpx;width:{{item.length}}rpx;transform:rotate({{item.angle}}deg)"></view><view wx:for="{{art.points}}" wx:key="index" class="star" style="left:{{item.x}}rpx;top:{{item.y}}rpx"></view><view class="halo"></view></view><view class="sign-caption"><text>{{art.name}} · {{art.symbol}}</text><text class="latin">{{art.latin}}</text></view></view>
