.sign-scene{position:relative;margin-top:26rpx;padding-top:8rpx;border-top:1rpx solid rgba(204,189,148,.18);overflow:hidden;color:#cbbd96}.sky{position:relative;width:600rpx;height:185rpx;margin:0 auto}.line{position:absolute;height:1rpx;background:rgba(218,202,161,.48);transform-origin:0 50%}.star{position:absolute;width:5rpx;height:5rpx;margin:-2rpx;border-radius:50%;background:#e2d3ab}.halo{position:absolute;width:260rpx;height:260rpx;left:160rpx;top:-45rpx;border:1rpx solid rgba(202,192,149,.08);border-radius:50%}.sign-caption{display:flex;justify-content:space-between;align-items:center;padding:0 4rpx 14rpx;font-size:21rpx;letter-spacing:3rpx}.latin{font-size:17rpx;letter-spacing:5rpx;opacity:.65}
