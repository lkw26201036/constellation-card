.sign-scene { position:relative; margin-top:32rpx; padding-top:8rpx; border-top:1rpx solid rgba(207,178,121,.3); overflow:hidden; background:radial-gradient(ellipse at 50% 90%,rgba(182,151,90,.14),transparent 70%); color:#eedab0; }
.sky { position:relative; width:600rpx; height:185rpx; margin:0 auto; }
.line { position:absolute; height:1rpx; background:rgba(229,203,149,.55); transform-origin:0 50%; }
.star { position:absolute; width:7rpx; height:7rpx; margin:-3rpx; border-radius:50%; background:#f5e5be; box-shadow:0 0 12rpx rgba(235,207,147,.7); }
.halo { position:absolute; width:300rpx; height:300rpx; left:140rpx; top:-70rpx; border:1rpx solid rgba(224,197,139,.12); border-radius:50%; }
.sign-caption { display:flex; justify-content:space-between; align-items:center; padding:0 8rpx 16rpx; font-size:23rpx; letter-spacing:3rpx; }
.latin { font-size:18rpx; letter-spacing:5rpx; opacity:.65; }
