<view class="paired-art" aria-hidden="true"><view wx:for="{{charts}}" wx:key="id" class="chart"><view class="chart-sky"><view wx:for="{{item.lines}}" wx:for-item="line" wx:key="id" class="line" style="left:{{line.x}}rpx;top:{{line.y}}rpx;width:{{line.length}}rpx;transform:rotate({{line.angle}}deg)"></view><view wx:for="{{item.points}}" wx:for-item="point" wx:key="id" class="point" style="left:{{point.x}}rpx;top:{{point.y}}rpx"></view></view><text>{{item.name}}</text></view><text class="connection">✦</text></view>
