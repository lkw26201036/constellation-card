.paired-art{position:relative;display:flex;gap:20rpx;border-top:1rpx solid rgba(213,193,150,.18);margin-top:28rpx;padding:25rpx 0 12rpx}.chart{flex:1;min-width:0;font-size:20rpx;color:#c4c7ac;text-align:center}.chart-sky{position:relative;width:270rpx;height:105rpx;margin:0 auto 12rpx}.line{position:absolute;height:1rpx;background:#b5ab7d;opacity:.6;transform-origin:0 50%}.point{position:absolute;width:4rpx;height:4rpx;margin:-2rpx;background:#ecdbac;border-radius:50%}.connection{position:absolute;left:50%;top:62rpx;transform:translateX(-50%);font-size:20rpx;color:#cdb77f}
