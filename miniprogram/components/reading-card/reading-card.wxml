<view wx:if="{{card.title}}" class="reading-card">
 <view class="card-topline"><text>{{kind}}</text><text class="edition">{{card.date}}</text></view>
 <block wx:if="{{card.type === 'spread'}}"><view class="spread-heading">给此刻的三束星光</view><view class="spread-triptych"><view wx:for="{{card.positions}}" wx:key="id" class="portrait-card"><text class="portrait-index">0{{item.position}}</text><image class="portrait-art" src="{{item.art}}" mode="aspectFit"/><view class="portrait-name">{{item.name}}</view><text class="portrait-keyword">{{item.keyword}}</text></view></view><view wx:for="{{card.positions}}" wx:key="id" class="position-reading"><view class="position-role">0{{item.position}} / {{item.role}}<text>{{item.name}}</text></view><view class="position-copy">{{item.text}}</view></view><view class="spread-note">{{card.summaryNote}}</view></block>
 <block wx:else><view class="card-title">{{card.title}}</view><view class="card-keyword"><view class="keyword-line"></view><text>{{card.keyword}}</text></view><view class="card-prose">{{card.summary || card.text}}</view></block>
 <view wx:if="{{card.traits}}" class="card-traits"><text class="trait" wx:for="{{card.traits}}" wx:key="*this">{{item}}</text></view>
 <view wx:if="{{card.type === 'daily' && card.sign !== '通用'}}" class="card-luck"><view class="luck-item"><text class="luck-label">幸运色</text><text>{{card.color}}</text></view><view><text class="luck-label">幸运数</text><text>{{card.number}}</text></view></view>
 <view wx:if="{{showAdvice && card.advice}}" class="card-advice"><view class="advice-label">{{card.type === 'book' ? '给自己一个小行动' : '给此刻的一点建议'}}</view><view>{{card.advice}}</view></view><sign-art sign="{{card.sign || ''}}"/>
</view>