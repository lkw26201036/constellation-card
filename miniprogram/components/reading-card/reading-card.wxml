<view wx:if="{{card.title}}" class="reading-card"><view class="card-topline"><text>{{kind}}</text><text class="edition">{{card.date}}</text></view><view class="card-title">{{card.title}}</view><view class="card-keyword"><view class="keyword-line"></view><text>{{card.keyword}}</text></view><view class="card-prose">{{card.summary || card.text}}</view><view wx:if="{{card.traits}}" class="card-traits"><text class="trait" wx:for="{{card.traits}}" wx:key="*this">{{item}}</text></view><view wx:if="{{card.type === 'daily'}}" class="card-luck"><view class="luck-item"><text class="luck-label">幸运色</text><text>{{card.color}}</text></view><view><text class="luck-label">幸运数</text><text>{{card.number}}</text></view></view><view wx:if="{{showAdvice && card.advice}}" class="card-advice"><view class="advice-label">给此刻的一点建议</view><view>{{card.advice}}</view></view><sign-art sign="{{card.sign || ''}}" /></view>
