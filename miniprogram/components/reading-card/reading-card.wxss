.reading-card { position:relative; padding:42rpx 36rpx 12rpx; background:#233f39; color:#f5f0e4; border-radius:24rpx; overflow:hidden; border:1rpx solid #304d43; }
.card-topline { display:flex; justify-content:space-between; align-items:center; gap:16rpx; color:#d0bd95; font-size:21rpx; letter-spacing:2rpx; line-height:1.6; }
.edition { font-size:19rpx; letter-spacing:1rpx; opacity:.8; }
.card-title { font-family:"Songti SC","STSong","Noto Serif CJK SC",serif; font-weight:500; font-size:48rpx; line-height:1.48; letter-spacing:2rpx; margin-top:38rpx; }
.card-keyword { display:flex; align-items:center; gap:16rpx; font-size:24rpx; color:#d9c191; margin-top:22rpx; letter-spacing:4rpx; }
.keyword-line { width:28rpx; height:1rpx; background:#b9a47d; }
.card-prose { font-size:27rpx; line-height:1.95; color:#e3e7dc; margin-top:30rpx; }
.card-traits { display:flex; gap:16rpx; flex-wrap:wrap; margin-top:26rpx; }
.trait { font-size:21rpx; padding-bottom:6rpx; border-bottom:1rpx solid #7e8f75; color:#d2c8ad; }
.card-luck { display:flex; gap:48rpx; margin-top:32rpx; padding-top:26rpx; border-top:1rpx solid rgba(216,196,154,.2); font-size:24rpx; }
.luck-item { display:flex; align-items:center; }
.luck-label { margin-right:14rpx; font-size:21rpx; color:#a8b7a6; }
.card-advice { border-top:1rpx solid rgba(216,196,154,.2); padding-top:25rpx; margin-top:30rpx; font-size:26rpx; line-height:1.85; color:#edf0e2; }
.advice-label { font-size:21rpx; color:#c4b48c; margin-bottom:12rpx; letter-spacing:2rpx; }

.spread-heading{font-family:"Songti SC","STSong",serif;font-size:40rpx;letter-spacing:2rpx;line-height:1.7;margin:24rpx 0}.spread-triptych{display:flex;gap:12rpx;align-items:flex-end;margin:28rpx 0 36rpx}.portrait-card{flex:1;min-width:0;position:relative;text-align:center;background:#1e3932;border:1rpx solid #7b8060;border-radius:8rpx;padding:12rpx 4rpx 17rpx;box-sizing:border-box}.portrait-card:nth-child(2){transform:translateY(-12rpx);background:#2c4b40}.portrait-art{display:block;width:100%;height:185rpx}.portrait-index{position:absolute;top:10rpx;left:10rpx;font-family:Georgia,serif;font-size:14rpx;color:#9f9d75}.portrait-name{font-family:serif;font-size:25rpx;color:#f0dfb7;letter-spacing:3rpx}.portrait-keyword{font-size:17rpx;color:#acb197;letter-spacing:2rpx;display:block;margin-top:9rpx}.position-reading{margin:27rpx 0}.position-role{display:flex;align-items:center;justify-content:space-between;gap:10rpx;font-size:20rpx;color:#c6b88e;letter-spacing:1rpx}.position-role text{font-size:22rpx;color:#e5d9b9}.position-copy{font-size:27rpx;line-height:1.95;color:#eee8d9;margin-top:12rpx}.spread-note{padding:22rpx 0;border-top:1rpx solid rgba(223,204,157,.2);color:#b7c0a7;font-size:22rpx;line-height:1.9}

.dice-edition{display:flex;align-items:center;gap:20rpx;margin:30rpx 0 12rpx;color:#d7bf8d;font-size:22rpx}.dice-edition>text{font-family:Georgia,serif;font-size:40rpx;border:1rpx solid #8a916c;padding:10rpx 16rpx;border-radius:10rpx}.dice-edition>view{font-size:23rpx;letter-spacing:3rpx}
