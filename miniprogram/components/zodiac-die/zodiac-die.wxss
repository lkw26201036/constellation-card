.dice-theatre{position:relative;width:100%;height:460rpx;perspective:1100rpx;overflow:hidden;background:radial-gradient(ellipse at 50% 55%,rgba(181,160,113,.12),transparent 65%)}.dice-orbit{position:absolute;width:390rpx;height:390rpx;border:1rpx solid #c6c9b4;border-radius:50%;left:50%;top:14rpx;transform:translateX(-50%);opacity:.5}.orbit-two{width:315rpx;height:315rpx;top:51rpx;border-style:dashed;opacity:.35}.orbit-mark{position:absolute;left:0;right:0;top:0;text-align:center;color:#b29c6b;font-size:25rpx}.dice-flight{position:absolute;width:186rpx;height:186rpx;left:50%;top:118rpx;margin-left:-93rpx;transform-style:preserve-3d;perspective:900rpx}.cube{width:100%;height:100%;position:relative;transform-style:preserve-3d;transition:transform 400ms cubic-bezier(.2,.7,.2,1)}.die-face{position:absolute;inset:0;background:#29483c;border:1rpx solid #9da179;box-sizing:border-box;border-radius:15rpx;backface-visibility:hidden;-webkit-backface-visibility:hidden;box-shadow:inset 0 0 18rpx rgba(9,30,22,.3);overflow:hidden}.face-2,.face-4{background:#203c32}.face-3{background:#1d382f}.face-5{background:#355243}.face-6{background:#244234}.face-frame{position:absolute;inset:9rpx;border:1rpx solid rgba(221,200,150,.35);border-radius:9rpx}.star-pip{position:absolute;color:#efddb1;font-size:27rpx;line-height:1;transform:translate(-50%,-50%);text-shadow:0 0 9rpx rgba(234,207,138,.3)}.face-chart{position:absolute;inset:0;opacity:.2;pointer-events:none}.face-line{position:absolute;height:1rpx;background:#f0daa8;transform-origin:left center}.face-sign{position:absolute;top:14rpx;right:15rpx;font-size:21rpx;font-family:serif;color:#e8d5a3;line-height:1}.face-sign.sign-1{left:15rpx;right:auto;color:#b7c6a2}.face-name{position:absolute;bottom:10rpx;left:0;right:0;text-align:center;font-size:14rpx;letter-spacing:5rpx;color:#bec6aa;line-height:1.5}.face-foil{position:absolute;inset:-50%;background:linear-gradient(115deg,transparent 44%,rgba(252,233,171,.11) 50%,transparent 56%);pointer-events:none}.dice-shadow{position:absolute;left:50%;top:329rpx;transform:translateX(-50%);width:180rpx;height:35rpx;border-radius:50%;background:radial-gradient(ellipse,rgba(30,52,33,.23),transparent 70%)}.dice-caption{position:absolute;left:0;right:0;bottom:20rpx;font-size:22rpx;text-align:center;color:#7a856b;letter-spacing:3rpx}.landing-wave{position:absolute;left:50%;top:282rpx;width:100rpx;height:100rpx;margin-left:-50rpx;border:1rpx solid #bba370;border-radius:50%;transform:rotateX(65deg);opacity:0}.rolling .cube{animation:star-tumble 1900ms cubic-bezier(.17,.55,.28,1) both}.rolling .dice-flight{animation:dice-hop 1900ms ease both}.rolling .dice-shadow{animation:shadow-hop 1900ms ease both}.rolling .landing-wave{animation:landing-light 700ms 1250ms both}.rolling .face-foil{animation:dice-foil 1800ms ease both}.rolling .star-pip{animation:pip-awake 600ms 1350ms both}@keyframes star-tumble{0%{transform:rotateX(var(--start-x)) rotateY(var(--start-y))}25%{transform:rotateX(250deg) rotateY(390deg)}65%{transform:rotateX(600deg) rotateY(850deg)}88%{transform:rotateX(calc(var(--roll-x) + 8deg)) rotateY(calc(var(--roll-y) - 5deg))}100%{transform:rotateX(var(--roll-x)) rotateY(var(--roll-y))}}@keyframes dice-hop{0%{transform:translateY(0) scale(.98)}25%{transform:translateY(-65rpx) scale(1.06)}65%{transform:translateY(8rpx) scale(.98)}79%{transform:translateY(-17rpx) scale(1)}100%{transform:translateY(0) scale(1)}}@keyframes shadow-hop{0%,100%{opacity:1;transform:translateX(-50%) scale(1)}25%{opacity:.3;transform:translateX(-50%) scale(.65)}65%{opacity:1;transform:translateX(-50%) scale(1.15)}}@keyframes landing-light{0%{opacity:0;transform:rotateX(65deg) scale(.5)}40%{opacity:.7}100%{opacity:0;transform:rotateX(65deg) scale(3)}}@keyframes dice-foil{from{transform:translateX(-60%)}to{transform:translateX(60%)}}@keyframes pip-awake{from{opacity:.4}to{opacity:1}}.reduced .cube{transition:none}@media(prefers-reduced-motion:reduce){.cube,.dice-flight,.dice-shadow,.landing-wave,.star-pip,.face-foil{animation:none!important;transition:none!important}}
