.dice-title{font-family:"Songti SC","STSong",serif;font-size:48rpx;letter-spacing:2rpx;line-height:1.6;margin:20rpx 0 10rpx}.dice-intro{font-size:24rpx;line-height:1.8;color:#738168}.throw-button{justify-content:space-between;margin-top:14rpx}.throw-button text{color:#d4bf8e}.quiet-button{background:transparent;color:#697b5e;font-size:23rpx;margin:10rpx 0 18rpx;padding:22rpx 0}.roll-copy{font-size:24rpx;line-height:1.8;text-align:center;color:#6e7e60}.dice-result{animation:dice-copy 600ms ease both}.result-actions{display:flex;gap:15rpx;margin-top:24rpx}.result-actions button{flex:1;padding:22rpx 8rpx;font-size:24rpx}.dice-note{text-align:center;color:#7d886f;line-height:1.9;font-size:20rpx;margin-top:30rpx}.dice-error{color:#885b3d;background:#eee6d8;font-size:24rpx;line-height:1.8;padding:20rpx;margin-top:20rpx}.pair-entry{background:transparent;display:flex;align-items:center;justify-content:space-between;text-align:left;color:#4f6547;gap:18rpx;border-top:1rpx solid #d8decd;border-bottom:1rpx solid #d8decd;border-radius:0;padding:24rpx 0;margin:30rpx 0 0;font-size:25rpx}.entry-kicker{font-size:18rpx;letter-spacing:2rpx;color:#7f896d;margin-bottom:9rpx}@keyframes dice-copy{from{opacity:0;transform:translateY(10rpx)}to{opacity:1;transform:translateY(0)}}.reduced .dice-result{animation:none}@media(prefers-reduced-motion:reduce){.dice-result{animation:none}}

/* V0.8 dice visual refinement */
.dice-page{background:linear-gradient(180deg,var(--paper) 0%,#eef0e7 58%,var(--paper) 100%)}
.next-step-note{margin:28rpx 0 2rpx;padding:18rpx 22rpx;border-left:2rpx solid #b5a179;background:rgba(229,232,220,.55);color:#53654f;font-size:24rpx;line-height:1.8}.next-step-note .section-index{margin-bottom:5rpx}
.dice-page .eyebrow{color:#76846b}.dice-title{font-size:51rpx;letter-spacing:1rpx;color:#263f34}.dice-intro{max-width:560rpx;color:#687861}
.dice-theatre{height:500rpx;margin:22rpx -8rpx 8rpx;border:1rpx solid rgba(158,164,130,.3);border-radius:var(--radius-lg);background:radial-gradient(ellipse at 50% 49%,rgba(188,171,124,.2),rgba(235,238,226,.1) 42%,rgba(227,232,217,.35) 100%);box-shadow:inset 0 0 0 1rpx rgba(255,255,255,.45),0 18rpx 38rpx rgba(63,81,57,.08)}
.dice-orbit{width:430rpx;height:430rpx;top:24rpx;border-color:rgba(138,148,115,.23)}.orbit-two{width:350rpx;height:350rpx;top:64rpx;border-color:rgba(176,157,106,.24)}
.dice-flight{width:212rpx;height:212rpx;margin-left:-106rpx;top:125rpx;filter:drop-shadow(0 20rpx 20rpx rgba(45,65,49,.12))}.die-face{border-radius:32rpx;clip-path:inset(0 round 32rpx);background:linear-gradient(145deg,#3c6654 0%,#1d3b32 72%);border:2rpx solid #c3ad78;box-shadow:inset 0 0 0 2rpx rgba(255,244,203,.11),inset -16rpx -18rpx 25rpx rgba(7,25,21,.24),0 20rpx 28rpx rgba(45,65,49,.18)}.face-frame{inset:12rpx;border-color:rgba(237,217,168,.55);border-radius:22rpx}.face-chart{opacity:.11}.face-line{height:2rpx;background:#e7d9ae}.star-pip{font-size:34rpx;color:#f8e6b7;text-shadow:0 0 14rpx rgba(241,211,137,.58)}.face-sign{font-size:24rpx;color:#f1e1b8;text-shadow:0 1rpx 3rpx rgba(16,37,28,.6)}.face-name{bottom:13rpx;font-size:18rpx;font-weight:600;color:#f1e2bd;letter-spacing:3rpx;text-shadow:0 1rpx 3rpx rgba(16,37,28,.72)}.dice-shadow{top:360rpx;width:220rpx;height:44rpx}.landing-wave{top:320rpx}.dice-caption{bottom:25rpx;color:#66745f;font-size:21rpx;letter-spacing:4rpx}.result-actions{gap:14rpx}.result-actions button{width:auto!important;flex:1;min-width:0}.dice-result{margin-top:26rpx}.pair-entry{background:rgba(252,251,247,.6);border:1rpx solid #c8d0bd;border-radius:15rpx;padding:23rpx 20rpx;margin-top:28rpx}.dice-note{margin-top:24rpx;color:#78846f}

/* final dice clarity */
.die-face{border-radius:38rpx;clip-path:inset(0 round 38rpx)}
.face-name{bottom:13rpx;padding:5rpx 16rpx;border-radius:999rpx;background:rgba(14,38,29,.48);font-size:20rpx;font-weight:600;color:#f6e6c1;letter-spacing:3rpx;text-shadow:0 1rpx 3rpx rgba(16,37,28,.72)}
