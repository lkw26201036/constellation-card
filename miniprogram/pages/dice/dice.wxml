<view class="page-shell dice-page {{reduced ? 'reduced' : ''}}"><view class="eyebrow">A LITTLE FORTUNE · 吉运骰子</view><view class="dice-title">{{context ? '摇出你们的小约定' : '摇出今天的小幸运'}}</view><view class="dice-intro">{{context ? '沿着刚才的星图，把心意放进一件小事。' : '六个方向，留给此刻一个轻盈的小行动。'}}</view>
 <zodiac-die value="{{face}}" rolling="{{phase === 'rolling'}}" signs="{{signs}}" reduced="{{reduced}}"/>
 <block wx:if="{{phase !== 'revealed'}}"><button wx:if="{{phase !== 'rolling' && !invalid}}" style="width:100%" class="primary-button throw-button" bindtap="roll">掷出星座骰子 <text>✦</text></button><block wx:if="{{phase === 'rolling'}}"><view class="roll-copy">星点翻转，正在寻找今天的落点…</view><button class="quiet-button" bindtap="skip">直接看这次结果</button></block></block>
 <block wx:else><view class="dice-result"><reading-card card="{{result}}" show-advice="{{true}}"/></view><view class="result-actions"><button style="width:100%" class="ghost-button" bindtap="poster">匿名海报 ↗</button><button style="width:100%" class="ghost-button" bindtap="save">{{isFavorite ? '已收藏 · 取消' : '收藏这次行动'}}</button></view><button class="quiet-button" bindtap="share">预览与分享这个{{context ? '小约定' : '小幸运'}} ↗</button><button style="width:100%" class="primary-button throw-button" bindtap="roll">再摇一个灵感 <text>↗</text></button></block>
 <view wx:if="{{error}}" class="dice-error" role="alert">{{error}}</view><button wx:if="{{!context && phase !== 'rolling'}}" class="pair-entry" bindtap="pair"><view><view class="entry-kicker">TWO STARS · 两个人一起</view><view>先展开星图，再摇一个小约定</view></view><text>↗</text></button><view class="dice-note"><view>六种行动方向 · 近期建议避重 · 免费重摇</view><view>点数不分吉凶，也不代表运气或契合高低</view></view></view>
