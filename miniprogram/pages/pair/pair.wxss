@import "../spread/spread.wxss";
.pair-selectors{display:flex;align-items:center;gap:14rpx;margin:36rpx 0}.pair-selectors picker{flex:1;min-width:0}.person-selector{text-align:center;border:1rpx solid #cdd2bf;background:#eeeee3;border-radius:16rpx;padding:27rpx 9rpx}.person-caption{font-size:21rpx;color:#778169;letter-spacing:2rpx}.person-glyph{font-family:serif;color:#7a8967;font-size:78rpx;line-height:1.5;margin:10rpx 0}.person-sign{font-size:25rpx;color:#36503d;line-height:1.8}.selector-cross{flex:none;color:#a48e5e;font-size:24rpx}.form-label{font-size:25rpx;color:#5c6e53;margin-bottom:17rpx}.relation-options,.gender-options{display:flex;gap:12rpx}.relation-options button,.gender-options button{flex:1;min-width:0;margin:0;padding:22rpx 4rpx;font-size:24rpx;background:#eeeee3;border:1rpx solid #d3d8c7;color:#69795c}.relation-options .selected,.gender-options .selected{background:#dce5d5;border-color:#819171;color:#264832}.private-toggle{font-size:22rpx;background:transparent;color:#748267;padding:25rpx 0;margin:6rpx 0 14rpx}.private-fields{padding:23rpx;border:1rpx solid #d8dccb;border-radius:12rpx;margin-bottom:25rpx}.private-hint{font-size:20rpx;color:#7d866f;line-height:1.8}.name-fields{display:flex;gap:18rpx;margin:18rpx 0 24rpx}.name-fields input{flex:1;min-width:0;border-bottom:1rpx solid #b9c1ab;height:65rpx;font-size:24rpx}.gender-options button{font-size:21rpx;padding:15rpx 4rpx}.form-note{font-size:20rpx;color:#78846e;line-height:1.9;margin-top:24rpx}.pair-dice-button{margin-top:25rpx;background:#345447;color:#ead7ad}.meeting-stars{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}.meeting-star{position:absolute;width:112rpx;height:112rpx;border:1rpx solid #a99c72;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:serif;font-size:64rpx;color:#a58e59;background:#eeeee1}.star-a{left:18%;animation:meet-a 850ms ease both}.star-b{right:18%;animation:meet-b 850ms ease both;color:#6b8363}.meeting-thread{height:1rpx;width:200rpx;background:linear-gradient(90deg,transparent,#bba472,transparent);animation:thread-in 850ms ease both}.meeting-stars>text{position:absolute;left:0;right:0;bottom:40rpx;text-align:center;font-size:22rpx;color:#79866c;letter-spacing:3rpx}@keyframes meet-a{from{opacity:0;transform:translateX(-45rpx)}to{opacity:1;transform:translateX(25rpx)}}@keyframes meet-b{from{opacity:0;transform:translateX(45rpx)}to{opacity:1;transform:translateX(-25rpx)}}@keyframes thread-in{from{opacity:0;transform:scaleX(.1)}to{opacity:1;transform:scaleX(1)}}@media(prefers-reduced-motion:reduce){.meeting-star,.meeting-thread{animation:none}}

/* V0.8 pair visual refinement */
.pair-page{background:linear-gradient(180deg,var(--paper) 0%,#eef0e7 58%,var(--paper) 100%)}.pair-page .pair-selectors{margin-top:28rpx}.pair-page .result-actions{gap:14rpx}.pair-page .result-actions button{width:auto!important;flex:1;min-width:0}.pair-page .pair-dice-button{box-shadow:0 10rpx 22rpx rgba(47,76,59,.14)}
.next-step-note{margin:30rpx 0 2rpx;padding:18rpx 22rpx;border-left:2rpx solid var(--gold);background:rgba(229,232,220,.55);color:#53654f;font-size:24rpx;line-height:1.8}.next-step-note .section-index{margin-bottom:5rpx}
