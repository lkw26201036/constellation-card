<view class="page-shell ritual-page pair-page {{reduced ? 'reduced' : ''}}">
 <view class="eyebrow">TWO STARS, ONE ATLAS · 双人星图</view><view class="ritual-title">让两束星光相遇</view><view class="ritual-subtitle">连接、差异与靠近，都可以慢慢探索</view>
 <block wx:if="{{phase === 'setup'}}">
  <view class="pair-selectors"><picker mode="selector" range="{{signNames}}" value="{{indexA}}" data-side="A" bindchange="chooseSign"><view class="person-selector"><text class="person-caption">我的星座</text><view class="person-glyph">{{starA}}</view><view class="person-sign">{{form.signA || '选择我的星座'}} ⌄</view></view></picker><view class="selector-cross">✦</view><picker mode="selector" range="{{signNames}}" value="{{indexB}}" data-side="B" bindchange="chooseSign"><view class="person-selector"><text class="person-caption">对方的星座</text><view class="person-glyph">{{starB}}</view><view class="person-sign">{{form.signB || '选择对方星座'}} ⌄</view></view></picker></view>
  <view class="form-label">你想探索哪一种相处？</view><view class="relation-options"><button wx:for="{{relations}}" wx:key="id" class="{{form.relation === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseRelation">{{item.name}}</button></view>
  <button class="private-toggle" bindtap="togglePrivate">昵称与关系描述 · 选填 {{privateOpen ? '⌃' : '⌄'}}</button>
  <view wx:if="{{privateOpen}}" class="private-fields"><view class="private-hint">仅在本机使用，不影响契合提示，不进入分享链接。</view><view class="name-fields"><input value="{{form.aliasA}}" data-field="aliasA" bindinput="nickname" maxlength="24" placeholder="我的昵称（选填）"/><input value="{{form.aliasB}}" data-field="aliasB" bindinput="nickname" maxlength="24" placeholder="对方昵称（选填）"/></view><view class="gender-options"><button data-id="" class="{{!form.gender ? 'selected' : ''}}" bindtap="chooseGender">不填写</button><button data-id="same" class="{{form.gender === 'same' ? 'selected' : ''}}" bindtap="chooseGender">同性</button><button data-id="different" class="{{form.gender === 'different' ? 'selected' : ''}}" bindtap="chooseGender">异性</button></view></view>
  <button style="width:100%" class="primary-button" bindtap="start">展开你们的星图 <text>↗︎</text></button>
  <button wx:if="{{last}}" class="quiet-action" bindtap="resume">回看上次的双人星图 →</button>
  <view class="form-note"><view>无需生日或私人问题。本次选择不改动个人绑定星座。</view><view>星座意象仅供娱乐，真实的理解来自你们的交流。</view></view>
 </block>
 <block wx:if="{{phase !== 'revealed' && phase !== 'setup'}}">
  <view class="ritual-stage {{phase}}">
   <view class="stage-ring"></view><view class="stage-orbit"></view><view class="stage-spark">✦</view><view wx:if="{{phase === 'connecting'}}" class="meeting-stars"><view class="meeting-star star-a">{{starA}}</view><view class="meeting-thread"></view><view class="meeting-star star-b">{{starB}}</view><text>让两束星光，慢慢靠近</text></view>
   <view wx:if="{{phase === 'selecting' || phase === 'dealing'}}" class="fan">
    <view wx:for="{{deck}}" wx:key="id" class="fan-anchor" style="--card-x:{{item.x}}rpx;--card-y:{{item.y}}rpx;--card-angle:{{item.angle}}deg;--card-delay:{{item.delay}}ms;z-index:{{item.index + 1}}"><view class="fan-card {{item.selected ? 'chosen' : ''}}" role="button" aria-label="{{item.selected ? '撤回第' + item.order + '张选择' : '选择第' + (item.index + 1) + '张牌'}}" data-index="{{item.index}}" bindtap="choose"><view class="card-emblem">✦</view><text class="fan-number">{{item.selected ? '已选 ' + item.order : '0' + (item.index + 1)}}</text></view></view>
   </view>
   <view wx:if="{{phase === 'revealing'}}" class="reveal-array"><view class="array-line"><view class="array-beam beam-one"></view><view class="array-beam beam-two"></view><view class="array-beam beam-three"></view><view class="array-glow">✦</view></view><view wx:for="{{result.positions}}" wx:key="id" class="reveal-shell position-{{index}}" style="animation-delay:{{index * 300}}ms"><view class="reveal-card" style="animation-delay:{{index * 300}}ms"><view class="reveal-back"><text>✦</text></view><view class="reveal-front"><image src="{{item.art}}" mode="aspectFit"/><text>{{item.name}}</text><view class="foil"></view></view></view></view></view>
  </view>
  <view wx:if="{{draft && phase !== 'revealing'}}" class="selection-slots"><view wx:for="{{slots}}" wx:key="index" class="selection-slot {{item.card ? 'filled' : ''}}" data-slot="{{index}}" bindtap="undo"><view wx:if="{{item.card}}" class="slot-back">✦</view><text class="slot-number">0{{index + 1}}</text><view>{{item.card ? '已选 · 点击撤回' : '等待你的选择'}}</view><text class="slot-role">{{item.role}}</text></view></view>
  <view class="ritual-caption">{{phase === 'connecting' ? '相遇不需要答案，先给彼此三个观察角度' : phase === 'dealing' ? '让星光慢慢铺开…' : phase === 'revealing' ? '让三个角度，依次来到你面前' : draft.selected.length + ' / 3 已选 · 揭晓前可点击撤回'}}</view>
  <button style="width:100%" wx:if="{{phase === 'selecting'}}" class="primary-button" disabled="{{draft.selected.length !== 3}}" bindtap="reveal">翻开星图 <text>✦</text></button>
  <button wx:if="{{phase === 'connecting' || phase === 'dealing' || phase === 'revealing'}}" class="quiet-action" bindtap="skip">跳过动画 {{phase === 'revealing' ? '· 查看结果' : '· 继续选牌'}}</button>
 </block>
 <block wx:if="{{phase === 'revealed'}}"><view class="result-reveal"><reading-card card="{{result}}" show-advice="{{true}}"/></view><view class="next-step-note"><view class="section-index">NEXT / 把理解变成一件小事</view><view>不急着给关系下结论，先把一次温和的回应交给今天。</view></view><action-followup card="{{result}}" bind:statuschange="actionChanged"/><button style="width:100%" class="primary-button pair-dice-button" bindtap="dice">摇出你们的小约定 <text>✦</text></button><view class="result-actions"><button style="width:100%" class="ghost-button" bindtap="poster">匿名海报 ↗︎</button><button style="width:100%" class="ghost-button" bindtap="save">{{isFavorite ? '已收藏 · 取消' : '收藏整组'}}</button></view><view class="text-actions"><button bindtap="share">预览与分享</button><button wx:if="{{!reduced}}" bindtap="replay">重看揭晓</button></view><button style="width:100%" class="ghost-button" bindtap="start">同一组星座，再展开一次</button><button class="quiet-action" bindtap="edit">调整双方信息</button></block>
 <view wx:if="{{error}}" class="inline-error" role="alert">{{error}}</view><view class="ritual-footnote"><view>基础相处提示保持稳定 · 三张牌探索当次角度</view><view>自由参与，没有契合分数或吉凶高低</view></view>
</view>
