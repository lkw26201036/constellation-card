.eyebrow{color:#817467;font-size:23rpx;letter-spacing:3rpx}.page-title{font-size:43rpx;line-height:1.4;font-weight:600;margin-top:14rpx}.mode-switch{display:flex;background:#eae2d8;padding:7rpx;border-radius:18rpx;margin:32rpx 0}.mode{flex:1;font-size:26rpx;border-radius:13rpx;padding:20rpx 8rpx;background:transparent;color:#746657;margin:0}.mode.active{background:#fffaf4;color:#3c4849}.mode::after,.theme::after,.mood::after,.text-button::after,.quiz-link::after{border:0}.section-label{font-size:26rpx;margin:12rpx 0 20rpx}.theme-grid{display:flex;gap:14rpx}.theme{flex:1;text-align:left;background:#fffaf4;padding:22rpx 18rpx;border-radius:16rpx;font-size:25rpx;line-height:1.5;border:1rpx solid #dfd6c9;margin:0}.theme.chosen{background:#334c50;color:#fff7e7;border-color:#334c50}.theme-index{font-size:19rpx;display:block;opacity:.65;margin-bottom:14rpx;letter-spacing:3rpx}.mood-row{display:flex;gap:12rpx;align-items:center;margin:24rpx 0;font-size:23rpx;flex-wrap:wrap}.mood{width:auto;min-width:0;flex:0 0 auto;font-size:23rpx;padding:12rpx 18rpx;margin:0;background:transparent;color:#695b4d;border-radius:30rpx;border:1rpx solid #c9bdaf}.mood.chosen{background:#e3d1b4;border-color:#ad926d}.stage-caption{text-align:center;font-size:25rpx;color:#716454;margin:44rpx 0 28rpx}.deck{display:flex;gap:18rpx;justify-content:center;perspective:1100rpx;margin:30rpx 0 42rpx}.flip-shell{width:30%;height:330rpx;perspective:1100rpx}.flip-inner{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:transform 520ms ease}.picked .flip-inner{transform:rotateY(180deg)}.face{position:absolute;top:0;left:0;right:0;bottom:0;box-sizing:border-box;backface-visibility:hidden;border-radius:19rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;height:100%;overflow:hidden}.back{background:#293f44;color:#e8d4a8;border:1rpx solid #847351;padding:0}.back[disabled]{background:#293f44;color:#e8d4a8}.front{background:#d8c2a2;color:#314044;transform:rotateY(180deg);font-size:26rpx}.back-orbit{position:absolute;inset:18rpx;border:1rpx solid rgba(224,197,139,.38);border-radius:80rpx}.deck-star{font-size:60rpx;line-height:1.5}.deck-number{font-size:19rpx;letter-spacing:5rpx;margin-top:44rpx}.shuffling .flip-shell{animation:shuffle 480ms ease}.shuffling .flip-shell:nth-child(2){animation-delay:35ms}.shuffling .flip-shell:nth-child(3){animation-delay:65ms}@keyframes shuffle{0%,100%{transform:translateY(0)}45%{transform:translateY(-22rpx)}70%{transform:translateY(8rpx)}}.wide{width:100%;box-sizing:border-box;margin-top:22rpx;font-size:27rpx}.text-button{font-size:23rpx;color:#7c6d5c;background:transparent;margin-top:14rpx;padding:18rpx}.result-card{background:#293f44;color:#fff8eb;border-radius:26rpx;padding:34rpx 32rpx 12rpx;margin-top:30rpx;overflow:hidden}.result-label{font-size:22rpx;color:#d7c59e;letter-spacing:2rpx}.result-title{font-size:44rpx;font-weight:600;line-height:1.45;margin-top:35rpx}.result-keyword{font-size:25rpx;color:#e1c48d;margin-top:18rpx}.result-text{font-size:28rpx;line-height:1.85;margin-top:26rpx}.result-advice{font-size:26rpx;line-height:1.8;padding-top:24rpx;margin-top:26rpx;border-top:1rpx solid #617171}.mood-note{font-size:24rpx;line-height:1.8;color:#76654f;margin-top:22rpx}.result-actions{display:flex;gap:18rpx;margin-top:24rpx}.result-actions button{flex:1;font-size:25rpx;padding:22rpx 14rpx}.draw-note{font-size:22rpx;line-height:1.8;color:#7c6d5c;text-align:center;margin-top:24rpx}.quiz-link{margin:36rpx 0 12rpx;background:#e7dac4;display:flex;justify-content:space-between;align-items:center;text-align:left;padding:26rpx;border-radius:22rpx;font-size:27rpx;color:#493d31;line-height:1.6}.quiz-kicker{font-size:21rpx;color:#806d55;margin-bottom:6rpx}button:active{opacity:.8}@media(prefers-reduced-motion:reduce){.flip-inner{transition:none}.shuffling .flip-shell{animation:none}}
