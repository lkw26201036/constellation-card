.page-title{font-size:42rpx;font-weight:600;line-height:1.5;letter-spacing:1rpx;margin-top:12rpx}.mode-switch{display:flex;gap:28rpx;border-bottom:1rpx solid #d7dccf;margin:28rpx 0 32rpx}.mode{flex:1;width:50%;margin:0;padding:22rpx 0;background:transparent;border-radius:0;color:#65715e;font-size:26rpx;border-bottom:3rpx solid transparent}.mode.active{color:#2e4a3b;border-bottom-color:#63735a}.explore-options{margin-top:10rpx}.section-label{font-size:25rpx;color:#61705b;margin:0 0 20rpx}.theme-grid{display:flex;gap:14rpx}.theme{flex:1;margin:0;padding:22rpx 16rpx;text-align:left;font-size:25rpx;line-height:1.6;background:#fcfbf7;color:#4b5a45;border:1rpx solid #d7dccf;border-radius:15rpx}.theme.chosen{background:#e0e5d8;border-color:#78896b;color:#2e4734}.theme-index{display:block;font-size:19rpx;letter-spacing:3rpx;color:#65715e;margin-bottom:16rpx}.theme.chosen .theme-index{color:#6c7c5b}.mood-row{display:flex;flex-wrap:wrap;align-items:center;gap:12rpx;margin:28rpx 0 4rpx;font-size:22rpx;color:#65715e}.mood{min-width:0;flex:none;margin:0;padding:13rpx 8rpx;border-radius:30rpx;font-size:22rpx;line-height:1.4;background:transparent;color:#6b765e;border:1rpx solid #d8dccd}.mood.chosen{background:#e4e6d9;color:#3b563b;border-color:#9ea98e}.stage-caption{font-size:24rpx;line-height:1.8;color:#65715e;text-align:center;margin:40rpx 0 28rpx}.deck{display:flex;gap:20rpx;justify-content:center;perspective:1100rpx;margin:28rpx 0 36rpx}.flip-shell{width:30%;height:350rpx;perspective:1100rpx}.flip-inner{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:transform 480ms ease}.picked .flip-inner{transform:rotateY(180deg)}.face{position:absolute;top:0;left:0;right:0;bottom:0;box-sizing:border-box;backface-visibility:hidden;border-radius:15rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;height:100%;overflow:hidden}.back{background:#233f39;color:#d2bd91;border:1rpx solid #3b5448;padding:0}.front{background:#e2e3d4;color:#3e563e;transform:rotateY(180deg);font-size:27rpx;letter-spacing:3rpx;border:1rpx solid #b7c0a6}.back-orbit{position:absolute;top:14rpx;left:14rpx;right:14rpx;bottom:14rpx;border:1rpx solid rgba(209,189,145,.3);border-radius:9rpx}.deck-star{font-size:52rpx;line-height:1.7;font-weight:300}.deck-number{font-size:18rpx;letter-spacing:5rpx;margin-top:50rpx;opacity:.7}.shuffling .flip-shell{animation:shuffle 480ms ease}.shuffling .flip-shell:nth-child(2){animation-delay:25ms}.shuffling .flip-shell:nth-child(3){animation-delay:50ms}@keyframes shuffle{0%,100%{transform:translateY(0)}50%{transform:translateY(-14rpx)}}.wide{width:100%;box-sizing:border-box;margin-top:22rpx;font-size:26rpx}.text-button{width:100%;margin:12rpx 0 0;padding:20rpx;background:transparent;color:#65715e;font-size:23rpx;border-radius:0}.mood-note{font-size:24rpx;line-height:1.85;color:#65715e;margin:22rpx 0 0;padding-left:20rpx;border-left:2rpx solid #b9c3a8}.result-actions{display:flex;gap:16rpx;margin-top:24rpx}.result-action{flex:1;font-size:25rpx;padding:24rpx 12rpx}.draw-note{font-size:21rpx;line-height:1.85;color:#65715e;text-align:center;margin-top:24rpx}.quiz-link{margin:36rpx 0 0;background:transparent;display:flex;justify-content:space-between;gap:22rpx;align-items:center;text-align:left;padding:26rpx 0;border-top:1rpx solid #d9dece;border-bottom:1rpx solid #d9dece;border-radius:0;font-size:27rpx;color:#3c513d;line-height:1.65}.quiz-kicker{font-size:21rpx;color:#65715e;margin-bottom:8rpx}@media(prefers-reduced-motion:reduce){.flip-inner{transition:none}.shuffling .flip-shell{animation:none}}

.mode-switch{gap:12rpx}.mode{width:25%;min-width:0;font-size:23rpx}
