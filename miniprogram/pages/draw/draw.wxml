<view class="page-shell draw-page">
  <view class="draw-head">
    <view class="eyebrow">今日神谕 · {{selectedSign}}</view>
    <view class="title">让答案慢一点出现</view>
    <view class="muted">闭上眼睛，给直觉一个先说话的机会</view>
  </view>

  <view class="oracle-card {{isRevealed ? 'revealed' : ''}} {{isDrawing ? 'is-drawing' : ''}}" bindtap="reveal">
    <block wx:if="{{isDrawing}}">
      <view class="draw-orbit">✦</view>
      <view class="card-back-title">正在为你抽取</view>
      <view class="card-back-caption">让今天的答案自然出现</view>
    </block>
    <block wx:elif="{{!isRevealed}}">
      <view class="card-back-symbol">✦</view>
      <view class="card-back-title">点击翻开</view>
      <view class="card-back-caption">每一次抽签，都是和自己聊一会儿</view>
    </block>
    <block wx:else>
      <view class="result-label">{{result.sign}} · 今日神谕卡</view>
      <view class="result-title">{{result.title}}</view>
      <view class="result-keyword">{{result.keyword}}</view>
      <view class="result-text">{{result.text}}</view>
      <view class="result-advice">{{result.advice}}</view>
    </block>
  </view>

  <view wx:if="{{isRevealed}}" class="actions result-actions">
    <button class="primary-button" bindtap="saveResult">{{isFavorite ? '已收藏结果' : '收藏结果'}}</button>
    <button class="ghost-button" open-type="share">分享结果</button>
    <button class="ghost-button" bindtap="openDetail">查看完整卡片</button>
  </view>
  <view class="draw-note">{{isRevealed ? "今日卡片已保存，明天再来领取新的一张" : "每台设备每天免费抽一次，切换星座不增加次数"}}</view>
  <view class="draw-note">卡片用于娱乐与自我探索</view>
</view>
