<view class="page-shell detail-page"><block wx:if="{{card}}"><view class="detail-context"><text>{{shared ? '来自朋友的一张卡' : card.type === 'theme' ? card.themeLabel : card.type === 'quiz' ? '我的充电方式' : '留给自己的片刻'}}</text><text>{{card.sign === '通用' ? '十二星光' : card.sign}}</text></view><reading-card card="{{card}}" /><view class="advice"><view class="section-index">{{card.type === 'quiz' ? '给你的一个小建议' : '今天可以试试'}}</view><view class="body">{{card.tip || card.advice}}</view><block wx:if="{{card.signNote}}"><view class="section-index sign-note">给{{card.sign}}的小提醒</view><view class="body">{{card.signNote}}</view></block><view wx:if="{{card.moodNote}}" class="mood-note">{{card.moodLabel}}的此刻 · {{card.moodNote}}</view></view><view class="actions"><button wx:if="{{shared}}" class="primary-button" style="width:100%" bindtap="tryMine">{{card.type === 'quiz' ? '测测我的充电方式' : card.type === 'daily' ? '查看我的今日卡' : '抽取我的卡片'}}<text> →</text></button><button wx:else class="primary-button" style="width:100%" bindtap="openPoster">生成星座海报 <text>↗</text></button><view class="secondary-actions"><button class="ghost-button secondary-button" style="width:100%" bindtap="saveCard">{{isFavorite ? '已收藏 · 点击取消' : '收藏这张卡'}}</button><button class="ghost-button secondary-button" style="width:100%" open-type="share">分享给朋友</button></view><button class="text-button" style="width:100%" bindtap="secondaryAction">{{shared ? '把这张卡留成海报' : card.type === 'quiz' ? '再做一次测试' : '继续探索我的卡片'}} →</button></view><view class="footnote">{{card.date}} · {{card.type === 'quiz' ? '趣味偏好描述，不作为心理诊断' : '仅供娱乐与自我探索'}}</view></block><view wx:else class="empty"><view class="empty-symbol">✦</view><view class="empty-title">暂时找不到这张卡</view><view class="body">链接可能不完整，或本地记录已被移除。</view><button class="primary-button empty-action" style="width:100%" bindtap="tryMine">领取我的今日卡</button></view></view>
