<view class="page-shell detail-page"><block wx:if="{{card}}"><view class="detail-context"><text>{{shared ? '来自朋友的一张卡' : card.type === 'journey' ? '七日星光总结' : card.type === 'theme' ? card.themeLabel : card.type === 'quiz' ? '我的充电方式' : '留给自己的片刻'}}</text><text>{{card.pair ? card.pair.signA + ' × ' + card.pair.signB : card.sign === '通用' ? '十二星光' : card.sign}}</text></view><reading-card card="{{card}}" show-advice="{{card.type === 'spread' || card.type === 'book' || card.type === 'pair' || card.type === 'dice' || card.type === 'journey'}}" /><view wx:if="{{card.type !== 'spread' && card.type !== 'book' && card.type !== 'pair' && card.type !== 'dice' && card.type !== 'journey'}}" class="advice"><view class="section-index">{{card.type === 'journey' ? '带回下一周的一点建议' : card.type === 'quiz' ? '给你的一个小建议' : '今天可以试试'}}</view><view class="body">{{card.tip || card.advice}}</view><block wx:if="{{card.signNote}}"><view class="section-index sign-note">给{{card.sign}}的小提醒</view><view class="body">{{card.signNote}}</view></block><view wx:if="{{card.moodNote}}" class="mood-note">{{card.moodLabel}}的此刻 · {{card.moodNote}}</view></view><view class="actions"><button wx:if="{{card.type === 'pair'}}" class="ghost-button" style="width:100%;margin-bottom:18rpx" bindtap="openDice">摇出这组星座的小约定 ✦</button><button wx:if="{{shared}}" class="primary-button" style="width:100%" bindtap="tryMine">{{card.type === 'journey' ? '开始我的七日旅程' : card.type === 'quiz' ? '测测我的充电方式' : card.type === 'daily' ? '查看我的今日卡' : card.type === 'book' ? '翻开我的一页' : card.type === 'spread' ? '展开我的牌阵' : card.type === 'pair' ? '展开我的双人星图' : card.type === 'dice' ? '试试我的小方向' : '抽取我的卡片'}}<text> →</text></button><button wx:else class="primary-button" style="width:100%" bindtap="openPoster">留成分享海报 <text>↗︎</text></button><view class="secondary-actions"><button class="ghost-button secondary-button" style="width:100%" bindtap="saveCard">{{isFavorite ? '已收藏 · 点击取消' : '收藏这张卡'}}</button><button wx:if="{{card.type === 'pair' || card.type === 'dice'}}" class="ghost-button secondary-button" style="width:100%" bindtap="sharePreview">预览与分享</button><button wx:else class="ghost-button secondary-button" style="width:100%" open-type="share">分享给朋友</button></view><button class="text-button" style="width:100%" bindtap="secondaryAction">{{shared ? '把这张卡留成海报' : card.type === 'journey' ? '继续七日星光旅程' : card.type === 'quiz' ? '再做一次测试' : '继续探索我的卡片'}} →</button></view><view class="footnote">{{card.date}} · {{card.type === 'quiz' ? '趣味偏好描述，不作为心理诊断' : '仅供娱乐与自我探索'}}</view></block><view wx:else class="empty"><view class="empty-symbol">✦</view><view class="empty-title">暂时找不到这张卡</view><view class="body">链接可能不完整，或本地记录已被移除。</view><button class="primary-button empty-action" style="width:100%" bindtap="tryMine">领取我的今日卡</button></view></view>
