<view class="page-shell detail-page"><block wx:if="{{card}}"><view class="eyebrow">{{card.type === 'quiz' ? '趣味测试结果' : card.type === 'theme' ? card.themeLabel : card.type === 'daily' ? '每日星座卡' : '今日主签'}} · {{card.dateLabel || card.date}}</view><view class="detail-card"><view class="sign">{{card.sign}} · {{card.type === 'quiz' ? '我的充电方式' : '给此刻的一张卡'}}</view><view class="title">{{card.title}}</view><view class="keyword">{{card.keyword}}</view><view class="body">{{card.summary || card.text}}</view><view wx:if="{{card.traits}}" class="traits"><text wx:for="{{card.traits}}" wx:key="*this">{{item}}</text></view><view wx:if="{{card.type === 'daily'}}" class="luck">幸运色 · {{card.color}}　幸运数 · {{card.number}}</view><sign-art sign="{{card.sign}}" /></view><view class="advice"><view class="section-title">{{card.type === 'quiz' ? '给你的一个小建议' : '今天可以试试'}}</view><view class="body">{{card.tip || card.advice}}</view><block wx:if="{{card.signNote}}"><view class="section-title sign-note">给{{card.sign}}的小提醒</view><view class="body">{{card.signNote}}</view></block><view wx:if="{{card.moodNote}}" class="body">{{card.moodLabel}}的此刻 · {{card.moodNote}}</view></view><view class="actions"><button class="primary-button" bindtap="tryMine">{{card.type === 'quiz' ? '测测我的充电方式' : card.type === 'daily' ? '查看我的今日卡' : '抽取我的卡片'}}</button><button class="ghost-button" bindtap="saveCard">{{isFavorite ? '已收藏 · 点击取消' : '收藏这张卡'}}</button><button class="ghost-button" open-type="share">分享小程序</button><button class="ghost-button poster-button" bindtap="openPoster">生成星座海报</button></view><view class="footnote">{{card.date}} · {{card.type === 'quiz' ? '趣味偏好描述，不作为心理诊断' : '仅供娱乐与自我探索'}}</view></block><view wx:else class="empty"><view class="title">暂时找不到这张卡</view><view class="body">链接可能不完整，或本地记录已被移除。</view><button class="primary-button" bindtap="tryMine">领取我的今日卡</button></view></view>
