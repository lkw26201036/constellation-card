.eyebrow{color:#7e7166;font-size:23rpx;margin-bottom:28rpx;line-height:1.6}.detail-card{border-radius:26rpx;padding:38rpx 32rpx 12rpx;background:#293f44;color:#fff8eb;overflow:hidden}.sign{font-size:24rpx;color:#ddca9e;letter-spacing:2rpx}.title{font-size:46rpx;line-height:1.45;font-weight:600;margin-top:28rpx}.keyword{display:inline-block;font-size:25rpx;margin-top:22rpx;color:#ead09b}.body{font-size:28rpx;line-height:1.9;margin-top:24rpx}.luck{font-size:24rpx;margin-top:30rpx;line-height:1.8;color:#ddca9e}.traits{display:flex;gap:14rpx;flex-wrap:wrap;margin-top:24rpx}.traits text{font-size:22rpx;border:1rpx solid #6e7c75;padding:8rpx 15rpx;border-radius:24rpx;color:#e5d6b4}.advice{padding:32rpx;margin-top:24rpx;background:#fffaf4;border-radius:24rpx}.section-title{font-size:28rpx;font-weight:600}.sign-note{margin-top:32rpx}.actions{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:30rpx}.actions .primary-button{grid-column:span 2}.actions button{width:100%;box-sizing:border-box;font-size:26rpx}.footnote{font-size:22rpx;line-height:1.8;color:#7e7166;margin-top:28rpx;text-align:center}.empty{padding-top:100rpx;text-align:center}.empty button{margin-top:40rpx}
