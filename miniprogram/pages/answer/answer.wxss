.book-heading{font-family:"Songti SC","STSong",serif;font-size:48rpx;letter-spacing:2rpx;line-height:1.5;margin:20rpx 0 12rpx}.book-intro{color:#717963;font-size:24rpx;line-height:1.8}.book-scene{position:relative;height:530rpx;perspective:1600rpx;margin:10rpx -12rpx 0;overflow:hidden}.book-halo{position:absolute;left:50%;top:32rpx;transform:translateX(-50%);width:500rpx;height:460rpx;border-radius:50%;background:radial-gradient(ellipse,rgba(176,156,113,.17),transparent 68%)}.book-object{position:absolute;width:296rpx;height:403rpx;left:50%;top:57rpx;transform:translateX(-50%) rotate(-5deg);transform-style:preserve-3d}.book-pages{position:absolute;inset:8rpx -9rpx -8rpx 9rpx;background:repeating-linear-gradient(to bottom,#f1e8d5 0,#f1e8d5 4rpx,#d3c6a8 5rpx,#f1e8d5 6rpx);border-radius:4rpx 17rpx 17rpx 4rpx;box-shadow:14rpx 24rpx 32rpx rgba(64,62,39,.16);display:flex;align-items:center;flex-direction:column;color:#a59060;padding-top:100rpx;box-sizing:border-box}.book-pages text{font-size:19rpx;letter-spacing:2rpx}.page-rule{width:160rpx;height:1rpx;background:#b9a778;margin:30rpx 0}.book-pages .inner-star{font-size:50rpx;margin-top:20rpx}.book-cover{position:absolute;inset:0;background:#203d35;border-radius:4rpx 13rpx 13rpx 4rpx;border:1rpx solid #4f6551;box-shadow:inset 12rpx 0 0 #192f2a,inset 15rpx 0 0 #52604a;transform-origin:left center;backface-visibility:hidden;-webkit-backface-visibility:hidden}.cover-frame{position:absolute;inset:22rpx 19rpx 22rpx 29rpx;border:1rpx solid #8a8c68;border-radius:2rpx 8rpx 8rpx 2rpx;display:flex;align-items:center;flex-direction:column;color:#d7c294;padding-top:31rpx}.cover-latin{font-size:14rpx;letter-spacing:4rpx;line-height:1.8}.cover-latin.second{font-size:12rpx;letter-spacing:2rpx}.cover-star{font-size:51rpx;margin:25rpx 0 12rpx;border:1rpx solid rgba(207,185,135,.4);border-radius:50%;width:90rpx;height:105rpx;display:flex;align-items:center;justify-content:center}.cover-title{font-family:"Songti SC","STSong",serif;font-size:36rpx;letter-spacing:7rpx;padding-left:7rpx}.cover-sub{font-size:15rpx;letter-spacing:3rpx;margin-top:16rpx}.cover-rule{width:36rpx;height:1rpx;background:#b29a6a;margin:20rpx 0 10rpx}.cover-edition{font-family:Georgia,serif;font-size:15rpx;letter-spacing:3rpx}.turning-page{position:absolute;inset:10rpx -2rpx 5rpx 10rpx;background:#f1e9d7;border-radius:0 12rpx 12rpx 0;transform-origin:left center;opacity:0;backface-visibility:hidden}.opening .book-cover{animation:cover-open 1100ms cubic-bezier(.3,.6,.2,1) both}.opening .turning-page{animation:page-turn 1100ms 150ms both}.opening .book-object{animation:book-settle 1200ms both}.number-label{font-size:22rpx;color:#758068;letter-spacing:2rpx;margin-bottom:18rpx}.number-entry{display:flex;align-items:center;border-bottom:1rpx solid #bfc5ae;padding-bottom:13rpx;gap:16rpx}.number-entry input{flex:1;min-width:0;font-size:40rpx;color:#2e4939;height:70rpx;font-family:Georgia,serif}.number-placeholder{font-family:Arial,sans-serif;font-size:27rpx;color:#969c87}.number-entry button{flex:none;margin:0;padding:18rpx 0;background:transparent;color:#637357;font-size:23rpx}.book-open-button{margin-top:28rpx;justify-content:space-between}.book-note{font-size:20rpx;color:#7c836d;line-height:1.9;text-align:center;margin-top:28rpx}.opening-copy{font-size:25rpx;text-align:center;color:#617359;line-height:1.8}.quiet-button{background:transparent;color:#67755d;font-size:23rpx;margin:12rpx 0 18rpx;padding:22rpx 0}.answer-edition{font-family:Georgia,serif;letter-spacing:4rpx;color:#8a7d58;font-size:20rpx;margin:32rpx 0 18rpx}.result-actions{display:flex;gap:14rpx;margin-top:24rpx}.result-actions button{flex:1;padding:24rpx 12rpx;font-size:24rpx}.book-error{font-size:24rpx;line-height:1.7;color:#885b3d;background:#eee6d8;padding:20rpx;margin-top:20rpx}@keyframes cover-open{0%{transform:rotateY(0deg)}100%{transform:rotateY(-150deg)}}@keyframes page-turn{0%,15%{opacity:0;transform:rotateY(0)}20%{opacity:1}100%{opacity:0;transform:rotateY(-155deg)}}@keyframes book-settle{from{transform:translateX(-50%) rotate(-5deg)}to{transform:translateX(-30%) rotate(0)}}@media(prefers-reduced-motion:reduce){.opening .book-cover,.opening .turning-page,.opening .book-object{animation:none}.opening .book-cover{opacity:0}}

.answer-reveal{animation:answer-arrive 650ms ease both}.reduced .answer-reveal{animation:none}@keyframes answer-arrive{from{opacity:0;transform:translateY(9rpx)}to{opacity:1;transform:translateY(0)}}@media(prefers-reduced-motion:reduce){.answer-reveal{animation:none}}
