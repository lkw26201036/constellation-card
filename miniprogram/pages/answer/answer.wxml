<view class="page-shell answer-page {{reduced ? 'reduced' : ''}}">
 <view class="eyebrow">A PAGE FOR YOU · 答案之书</view><view class="book-heading">答案，也可以很温柔</view><view class="book-intro">把问题留在心里，选一个属于此刻的数字。</view>
 <block wx:if="{{phase !== 'open'}}">
  <view class="book-scene {{phase}}"><view class="book-halo"></view><view class="book-object"><view class="book-pages"><text>{{result ? result.keyword : '200 封写给自己的短信'}}</text><view class="page-rule"></view><text class="inner-star">✦</text></view><view class="book-cover"><view class="cover-frame"><text class="cover-latin">THE BOOK OF</text><text class="cover-latin second">GENTLE ANSWERS</text><view class="cover-star">✦</view><view class="cover-title">答案之书</view><text class="cover-sub">留一页，听听自己</text><view class="cover-rule"></view><text class="cover-edition">001 — 200</text></view></view><view class="turning-page"></view></view></view>
  <block wx:if="{{phase === 'closed'}}"><view class="number-label">在心里，选一个 1—200 的数字</view><view class="number-entry"><input type="number" value="{{value}}" placeholder="输入你的数字" placeholder-class="number-placeholder" bindinput="input" bindconfirm="open" confirm-type="done" aria-label="1至200的整数"/><button bindtap="random">替我选一个 ↗</button></view><button style="width:100%" class="primary-button book-open-button" bindtap="open">翻开这一页 <text>→</text></button></block>
  <block wx:else><view class="opening-copy">第 {{result.number}} 页，正在轻轻翻开…</view><button class="quiet-button" bindtap="skip">直接读这一页</button></block>
 </block>
 <block wx:else><view class="answer-edition">PAGE {{result.number}} / 200</view><view class="answer-reveal"><reading-card card="{{result}}" show-advice="{{true}}"/></view><view class="result-actions"><button style="width:100%" class="primary-button" bindtap="poster">留成海报 ↗</button><button style="width:100%" class="ghost-button" bindtap="save">{{isFavorite ? '已收藏 · 取消' : '收藏这一页'}}</button></view><button class="quiet-button" open-type="share">把这页温柔分享出去 ↗</button><button style="width:100%" class="ghost-button" bindtap="reset">再选一个数字</button></block>
 <view wx:if="{{error}}" class="book-error" role="alert">{{error}}</view><view class="book-note"><view>200条原创回应 · 同一个数字，对应同一页</view><view>没有好坏之分，只留一点陪伴和可尝试的小行动</view></view>
</view>
