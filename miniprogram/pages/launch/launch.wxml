<view class="launch-shell {{reduced ? 'reduced' : ''}} {{leaving ? 'leaving' : ''}}" catchtouchmove="swallow"><view class="ambient ambient-one"></view><view class="ambient ambient-two"></view><view class="launch-main"><block wx:if="{{running || error}}"><view class="brand"><view class="eyebrow">DAILY CONSTELLATION</view><view class="wordmark">星座卡牌</view><view class="brand-rule"></view></view><view class="stage-viewport"><view wx:if="{{running}}" class="chart-scene" aria-hidden="true"><view class="orbit orbit-outer"></view><view class="orbit orbit-inner"></view><view class="orbit-cross cross-horizontal"></view><view class="orbit-cross cross-vertical"></view><view class="orbit-sweep"></view><view wx:for="{{scene.ticks}}" wx:key="id" class="tick" style="left:{{item.x}}rpx;top:{{item.y}}rpx;transform:rotate({{item.angle}}deg)"></view><view wx:for="{{scene.lines}}" wx:key="id" class="trace-track" style="left:{{item.x}}rpx;top:{{item.y}}rpx;width:{{item.length}}rpx;transform:rotate({{item.angle}}deg)"><view class="trace" style="animation-delay:{{item.delay}}ms"></view></view><view wx:for="{{scene.points}}" wx:key="id" class="node {{item.bright ? 'bright' : ''}}" style="left:{{item.x}}rpx;top:{{item.y}}rpx;animation-delay:{{item.delay}}ms"></view><view class="chart-label label-top">✦</view><view class="chart-label label-bottom">{{signChosen ? scene.latin : 'TWELVE SIGNS'}}</view></view></view><view class="signature">{{signChosen ? sign + ' · 今日星图' : '十二星座 · 一张属于你的卡'}}</view><view class="tagline">给今天，一点方向</view></block></view><view class="launch-footer"><block wx:if="{{error}}"><view class="error-note">暂时没有打开首页，请再试一次。</view><button class="enter-button" style="width:100%" bindtap="skip">进入首页 →</button></block><block wx:elif="{{preview}}"><view class="preview-caption">启动动效预览{{reduced ? ' · 已开启减少动效' : ''}}</view><view class="preview-actions"><button wx:if="{{!reduced}}" class="replay-button" style="width:100%" bindtap="replay">再看一次</button><button class="enter-button" style="width:100%" bindtap="closePreview">返回</button></view></block><block wx:else><button class="skip-button" style="width:100%" bindtap="skip">直接进入 <text class="skip-arrow">→</text></button><view class="footer-note">留一个片刻，听听自己</view></block></view></view>
