page{background:#1a332d;color:#f2eddd}.launch-shell{height:100vh;box-sizing:border-box;position:relative;overflow:hidden;background:#1a332d;display:flex;flex-direction:column;align-items:center;padding:calc(90rpx + env(safe-area-inset-top)) 48rpx calc(26rpx + env(safe-area-inset-bottom));opacity:1;transition:opacity 180ms ease}.launch-shell.leaving{opacity:0;pointer-events:none}.ambient{position:absolute;border-radius:50%;pointer-events:none}.ambient-one{width:800rpx;height:800rpx;left:50%;top:46%;transform:translate(-50%,-50%);background:radial-gradient(ellipse,rgba(104,125,86,.12),rgba(26,51,45,0) 66%)}.ambient-two{width:560rpx;height:560rpx;left:-400rpx;bottom:-330rpx;border:1rpx solid rgba(190,178,139,.07)}.launch-main{width:100%;flex:1;min-height:0;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative}.brand{text-align:center;position:relative;z-index:1;animation:brand-in 600ms ease both}.eyebrow{font-size:17rpx;letter-spacing:6rpx;color:#9fae91;line-height:1.8}.wordmark{font-family:"Songti SC","STSong",serif;font-size:54rpx;line-height:1.6;font-weight:400;letter-spacing:12rpx;color:#eee7d3;padding-left:12rpx;margin-top:16rpx}.brand-rule{height:1rpx;width:48rpx;background:#ad9b74;margin:22rpx auto 0;opacity:.7}.stage-viewport{position:relative;flex:none;width:520rpx;height:520rpx;max-height:42vh;margin-top:4rpx}.chart-scene{position:absolute;width:520rpx;height:520rpx;left:50%;top:50%;transform:translate(-50%,-50%)}.orbit{position:absolute;border-radius:50%;box-sizing:border-box;border:1rpx solid rgba(206,190,145,.2);animation:ring-in 1000ms ease both}.orbit-outer{width:450rpx;height:450rpx;left:35rpx;top:35rpx}.orbit-inner{width:350rpx;height:350rpx;left:85rpx;top:85rpx;border-color:rgba(206,190,145,.13)}.orbit-cross{position:absolute;background:rgba(206,190,145,.07)}.cross-horizontal{width:350rpx;height:1rpx;left:85rpx;top:260rpx}.cross-vertical{width:1rpx;height:350rpx;left:260rpx;top:85rpx}.orbit-sweep{position:absolute;width:450rpx;height:450rpx;box-sizing:border-box;left:35rpx;top:35rpx;border-radius:50%;border:1rpx solid transparent;border-top-color:#c4ae7b;animation:orbit-arrive 1700ms cubic-bezier(.2,.6,.2,1) both}.tick{position:absolute;height:8rpx;width:1rpx;margin-left:-.5rpx;margin-top:-4rpx;background:#b3a57f;opacity:.55}.trace-track{position:absolute;height:1rpx;transform-origin:0 50%}.trace{width:100%;height:1rpx;background:#d6c294;transform-origin:0 50%;animation:draw-line 440ms ease-out both}.node{position:absolute;width:6rpx;height:6rpx;margin:-3rpx;border-radius:50%;background:#ede0b5;box-shadow:0 0 10rpx rgba(233,214,168,.18);animation:star-in 420ms ease both}.node.bright{width:10rpx;height:10rpx;margin:-5rpx;background:#fff0c6;box-shadow:0 0 22rpx rgba(231,213,161,.4)}.chart-label{position:absolute;left:0;right:0;text-align:center;font-size:17rpx;letter-spacing:5rpx;color:#a89d7b}.label-top{top:67rpx;font-size:23rpx;line-height:1}.label-bottom{bottom:69rpx;font-size:15rpx;color:#a3ad90;letter-spacing:4rpx}.signature{font-size:22rpx;letter-spacing:4rpx;color:#c8c7aa;line-height:1.8;animation:copy-in 700ms 400ms both}.tagline{font-family:"Songti SC","STSong",serif;font-size:34rpx;letter-spacing:5rpx;font-weight:400;line-height:1.8;color:#e4ddc6;margin-top:22rpx;animation:copy-in 800ms 650ms both}.launch-footer{position:relative;z-index:2;width:100%;flex:none;text-align:center;padding-top:28rpx}.skip-button{display:flex;align-items:center;justify-content:center;gap:26rpx;min-height:86rpx;background:transparent;color:#c0c5aa;font-size:23rpx;font-weight:400;letter-spacing:3rpx;margin:0;padding:20rpx;border-radius:0}.skip-arrow{font-size:28rpx;color:#c9b283}.footer-note{font-size:19rpx;letter-spacing:3rpx;color:#a0ad92;line-height:1.8}.preview-caption{font-size:20rpx;letter-spacing:2rpx;color:#b2bba2;margin-bottom:20rpx;line-height:1.7}.preview-actions{display:flex;gap:18rpx}.enter-button,.replay-button{flex:1;box-sizing:border-box;min-height:82rpx;border-radius:12rpx;font-size:25rpx;font-weight:400;letter-spacing:2rpx;margin:0;padding:22rpx;background:#d2c19b;color:#294033}.replay-button{border:1rpx solid #6e8066;background:transparent;color:#cdd1b9}.error-note{font-size:24rpx;color:#dfd2ae;margin-bottom:22rpx;line-height:1.8}@keyframes brand-in{from{opacity:0;transform:translateY(8rpx)}to{opacity:1;transform:translateY(0)}}@keyframes ring-in{from{opacity:0;transform:scale(.97)}to{opacity:1;transform:scale(1)}}@keyframes orbit-arrive{0%{opacity:0;transform:rotate(-100deg)}15%{opacity:.9}85%{opacity:.6}100%{opacity:0;transform:rotate(190deg)}}@keyframes draw-line{from{opacity:0;transform:scaleX(0)}to{opacity:.7;transform:scaleX(1)}}@keyframes star-in{from{opacity:0;transform:scale(.3)}to{opacity:1;transform:scale(1)}}@keyframes copy-in{from{opacity:0;transform:translateY(7rpx)}to{opacity:1;transform:translateY(0)}}.reduced .brand,.reduced .orbit,.reduced .node,.reduced .signature,.reduced .tagline{animation:none;opacity:1;transform:none}.reduced .trace{animation:none;opacity:.7;transform:scaleX(1)}.reduced .orbit-sweep{display:none}.reduced{transition:none}@media(max-height:650px){.launch-shell{padding-top:calc(62rpx + env(safe-area-inset-top));padding-bottom:calc(18rpx + env(safe-area-inset-bottom))}.stage-viewport{height:410rpx}.chart-scene{transform:translate(-50%,-50%) scale(.78)}.wordmark{font-size:46rpx;margin-top:8rpx}.brand-rule{margin-top:12rpx}.tagline{font-size:29rpx;margin-top:12rpx}.launch-footer{padding-top:16rpx}.signature{font-size:20rpx}.skip-button{min-height:72rpx}}@media(prefers-reduced-motion:reduce){.brand,.orbit,.node,.signature,.tagline{animation:none;opacity:1;transform:none}.trace{animation:none;opacity:.7;transform:scaleX(1)}.orbit-sweep{display:none}.launch-shell{transition:none}}

.preview-modes{display:flex;justify-content:center;gap:8rpx;margin:0 auto 20rpx;padding:6rpx;width:360rpx;border:1rpx solid rgba(211,192,147,.22);border-radius:12rpx}.mode-button{width:50%;margin:0;padding:0;line-height:62rpx;font-size:23rpx;letter-spacing:2rpx;color:#a6b5a7;background:transparent;border-radius:7rpx}.mode-button::after{border:0}.mode-button.active{background:rgba(211,192,147,.13);color:#e4d6b7}.mode-button.unavailable{opacity:.5}
