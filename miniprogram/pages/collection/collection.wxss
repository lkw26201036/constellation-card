.title{font-size:41rpx;font-weight:600;line-height:1.5;letter-spacing:1rpx;margin-top:12rpx}.intro{font-size:23rpx;color:#65715e;margin-top:18rpx;line-height:1.8}.source-tabs{display:flex;gap:22rpx;border-bottom:1rpx solid #d6ddcc;margin:28rpx 0 0}.source{flex:1;width:33%;margin:0;padding:22rpx 0;background:transparent;border-radius:0;font-size:25rpx;color:#65715e;border-bottom:3rpx solid transparent}.source.active{color:#355036;border-bottom-color:#6b805c}.filter-scroll{width:100%;margin:24rpx 0}.filters{display:flex;gap:14rpx;white-space:nowrap}.filter{flex:none;width:112rpx;margin:0;padding:14rpx 0;font-size:23rpx;line-height:1.5;border-radius:28rpx;background:transparent;color:#65715e}.filter.active{background:#e2e8d8;color:#42603b}.card-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18rpx}.mini-card{position:relative;box-sizing:border-box;padding:30rpx 24rpx 78rpx;min-height:300rpx;background:#233f39;color:#f0efdf;border-radius:18rpx;border:1rpx solid #365343;overflow:hidden}.type-quiz{background:#65664f;border-color:#77785f}.type-daily{background:#465b4b;border-color:#586e56}.type-oracle{background:#344a3d;border-color:#49624a}.mini-type{font-size:20rpx;color:#c6bd9a;padding-right:40rpx;line-height:1.6;letter-spacing:1rpx}.mini-title{font-family:"Songti SC","STSong",serif;font-size:32rpx;font-weight:500;line-height:1.65;margin-top:26rpx;word-break:break-all}.mini-keyword{font-size:22rpx;letter-spacing:2rpx;color:#c4ccad;margin-top:18rpx}.mini-sign{position:absolute;bottom:26rpx;left:24rpx;right:24rpx;padding-top:14rpx;border-top:1rpx solid rgba(212,219,189,.2);font-size:18rpx;color:#bac7a8;line-height:1.6}.remove{position:absolute;right:0;top:0;width:78rpx;height:78rpx;display:flex;align-items:center;justify-content:center;font-size:30rpx;color:#cbd2b6;font-weight:300}.empty{padding:68rpx 25rpx;text-align:center;font-size:29rpx;background:#fcfbf7;border:1rpx solid #dfe4d4;border-radius:20rpx;line-height:1.7}.empty-note{font-size:24rpx;color:#65715e;margin-top:16rpx}.empty-action{margin-top:30rpx;font-size:26rpx}.note{font-size:22rpx;line-height:1.9;color:#65715e;margin:26rpx 0}.gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx}.gallery-card{border:1rpx dashed #cfd7bf;border-radius:16rpx;padding:23rpx 13rpx;min-height:192rpx;box-sizing:border-box;text-align:center;color:#65715e;background:#edf0e5}.gallery-card.unlocked{background:#304c3a;color:#e4e5cf;border:1rpx solid #496044}.gallery-top{font-size:18rpx;letter-spacing:2rpx;opacity:.75}.gallery-title{font-family:"Songti SC","STSong",serif;font-size:25rpx;line-height:1.7;margin-top:22rpx;word-break:break-all}.gallery-label{font-size:18rpx;opacity:.7;margin-top:20rpx}

.weekly-entry{display:flex;align-items:center;justify-content:space-between;width:100%;margin-top:22rpx;padding:22rpx 24rpx;background:#e7eadc;color:#3f563e;border-radius:var(--radius-md);text-align:left;font-size:25rpx}.weekly-entry-note{font-size:20rpx;color:#65715e;margin-top:6rpx;line-height:1.6}.weekly-entry>text{font-size:28rpx;color:var(--gold)}
