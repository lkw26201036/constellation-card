.eyebrow {
  color: #a1968c;
  font-size: 23rpx;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
}

.intro {
  margin-top: 18rpx;
  font-size: 26rpx;
}

.stats-row {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.stat-pill {
  padding: 16rpx 22rpx;
  color: #88786c;
  background: #fffaf4;
  border-radius: 999rpx;
  font-size: 23rpx;
}

.stat-number {
  margin-right: 6rpx;
  color: #aa8278;
  font-size: 32rpx;
  font-weight: 600;
}

.collection-list {
  margin-top: 36rpx;
}

.collection-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 30rpx 24rpx;
  margin-bottom: 18rpx;
  border-radius: 24rpx;
  background: #fffaf4;
  animation: list-enter 360ms ease both;
}

.collection-symbol {
  width: 74rpx;
  height: 74rpx;
  line-height: 74rpx;
  text-align: center;
  color: #fffaf4;
  background: #b49375;
  border-radius: 22rpx;
  font-size: 32rpx;
}

.collection-content {
  flex: 1;
  min-width: 0;
}

.collection-title {
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.collection-meta {
  margin-top: 10rpx;
  color: #a1968c;
  font-size: 23rpx;
}

.collection-remove {
  padding: 10rpx;
  color: #b7aaa0;
  font-size: 38rpx;
}

.empty-state {
  text-align: center;
  color: #9d938b;
  margin-top: 120rpx;
}

.empty-symbol {
  color: #c8ae92;
  font-size: 58rpx;
  margin-bottom: 16rpx;
}

.empty-caption {
  margin: 14rpx auto 0;
  max-width: 430rpx;
  color: #b7aaa0;
  font-size: 23rpx;
  line-height: 1.7;
}

.history-section {
  margin-top: 58rpx;
}

.section-title {
  margin-bottom: 18rpx;
  color: #6a5b52;
  font-size: 30rpx;
  font-weight: 600;
}

.history-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #ede2d8;
}

.history-title {
  font-size: 26rpx;
}

.history-date {
  color: #b0a39a;
  font-size: 22rpx;
}

@keyframes list-enter {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}
