.title{font-size:42rpx;font-weight:600;line-height:1.5;margin:12rpx 0 30rpx;letter-spacing:1rpx}.poster-image{display:block;width:100%;box-sizing:border-box;border:1rpx solid #52654c;border-radius:12rpx;box-shadow:0 8rpx 20rpx rgba(42,67,44,.06)}.poster-action{width:100%;box-sizing:border-box;margin-top:20rpx;font-size:26rpx}.status{padding:90rpx 24rpx;text-align:center;font-size:27rpx;color:#65715e;line-height:1.8}.status-mark{font-size:58rpx;color:#a7af91;margin-bottom:25rpx}.note{font-size:22rpx;line-height:1.9;color:#65715e;margin-top:26rpx}.poster-canvas{position:fixed;left:-9999px;top:0;width:650px;height:1200px}

.poster-page .primary-button,.poster-page .ghost-button{margin-top:24rpx}
