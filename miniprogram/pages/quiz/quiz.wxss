.eyebrow{font-size:23rpx;color:#817467;letter-spacing:2rpx}.title{font-size:46rpx;line-height:1.45;font-weight:600;margin-top:24rpx}.intro-art{background:#293f44;color:#ead7ad;border-radius:26rpx;text-align:center;padding:60rpx 24rpx;margin-top:36rpx}.intro-art text{font-size:100rpx}.intro-art view{font-size:24rpx;letter-spacing:5rpx;margin-top:28rpx}.intro{font-size:29rpx;line-height:1.9;margin-top:32rpx}.wide{width:100%;margin-top:36rpx;font-size:28rpx}.note{font-size:23rpx;line-height:1.85;color:#7c6d5c;margin-top:28rpx}.progress-row{display:flex;justify-content:space-between;font-size:23rpx;color:#7c6d5c;margin-top:36rpx}.progress{height:6rpx;background:#dfd5c6;margin-top:20rpx;border-radius:8rpx}.progress view{height:100%;background:#627e79;border-radius:8rpx}.question{font-size:35rpx;font-weight:600;line-height:1.5;margin:42rpx 0 30rpx}.option{display:flex;align-items:center;gap:20rpx;text-align:left;width:100%;font-size:28rpx;line-height:1.6;background:#fffaf4;border:1rpx solid #dfd6c9;color:#4a4036;padding:26rpx;border-radius:18rpx;margin-top:18rpx}.option::after{border:0}.option.selected{background:#e1e7e2;border-color:#708a7f}.option-number{font-size:21rpx;color:#85725c}.quiz-actions{display:flex;gap:20rpx;margin-top:38rpx}.quiz-actions button{flex:1;font-size:27rpx}.quiz-actions button[disabled]{background:#dbd3c8;color:#82776b}button:active{opacity:.8}
