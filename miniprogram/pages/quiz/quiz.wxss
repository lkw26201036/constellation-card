.title{font-size:43rpx;line-height:1.55;font-weight:600;letter-spacing:1rpx;margin-top:20rpx}.intro-art{background:#233f39;color:#d8c297;border:1rpx solid #385344;border-radius:24rpx;text-align:center;padding:46rpx 24rpx 34rpx;margin-top:32rpx}.intro-orbit{width:156rpx;height:156rpx;border:1rpx solid rgba(210,189,145,.35);border-radius:50%;margin:0 auto;display:flex;align-items:center;justify-content:center}.intro-symbol{font-size:65rpx;font-weight:300}.intro-caption{font-size:23rpx;letter-spacing:5rpx;color:#bcc8ae;margin-top:32rpx}.intro{font-size:29rpx;line-height:1.9;color:#52624b;margin-top:30rpx}.quiz-facts{display:flex;justify-content:space-between;padding:22rpx 0;border-top:1rpx solid #dbdfd0;border-bottom:1rpx solid #dbdfd0;margin-top:26rpx;font-size:22rpx;color:#65715e}.wide{margin-top:30rpx}.note{font-size:22rpx;line-height:1.9;color:#65715e;margin-top:28rpx}.text-button{margin:10rpx 0 0;background:transparent;color:#65715e;font-size:24rpx;padding:20rpx;border-radius:0}.progress-row{display:flex;justify-content:space-between;font-size:23rpx;color:#4d6349;margin-top:36rpx;gap:16rpx}.total{color:#929a82;margin-left:5rpx}.progress{height:3rpx;background:#d8decd;margin-top:20rpx}.progress view{height:100%;background:#788c68}.question{font-family:"Songti SC","STSong",serif;font-size:37rpx;font-weight:500;line-height:1.7;margin:38rpx 0 28rpx}.option{display:flex;align-items:center;gap:20rpx;text-align:left;margin:16rpx 0 0;padding:28rpx 24rpx;background:#fcfbf7;border:1rpx solid #dce1d2;border-radius:15rpx;color:#40553d;font-size:27rpx;line-height:1.65;min-height:100rpx}.option.selected{background:#e5eadd;border-color:#889b75}.option-number{font-size:20rpx;letter-spacing:1rpx;color:#9aa18a}.option-copy{flex:1}.option-dot{width:18rpx;height:18rpx;border:1rpx solid #bec7b0;border-radius:50%;box-sizing:border-box}.option-dot.checked{background:#67815a;border:4rpx solid #d0dbbf;box-shadow:0 0 0 1rpx #8b9f79}.quiz-actions{display:flex;gap:18rpx;margin-top:34rpx}.quiz-nav{flex:1;width:100%;min-width:0;font-size:26rpx}.quiz-nav.is-disabled{background:#d8dfcd;color:#65715e}
