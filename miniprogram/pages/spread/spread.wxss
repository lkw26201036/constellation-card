.ritual-title{font-family:"Songti SC","STSong",serif;font-size:52rpx;letter-spacing:3rpx;margin:20rpx 0 12rpx}.ritual-subtitle{font-size:24rpx;color:#707863;line-height:1.8}.ritual-stage{height:490rpx;position:relative;margin:24rpx -16rpx 0;overflow:hidden;perspective:1200rpx;background:radial-gradient(ellipse at center,rgba(181,161,121,.1),transparent 67%)}.stage-ring,.stage-orbit{position:absolute;border:1rpx solid rgba(143,149,119,.2);border-radius:50%;width:390rpx;height:390rpx;left:50%;top:45rpx;transform:translateX(-50%)}.stage-orbit{width:315rpx;height:315rpx;top:83rpx;border-style:dashed;opacity:.5}.stage-spark{position:absolute;left:0;right:0;top:25rpx;text-align:center;color:#a69364;font-size:27rpx}.resting-card,.fan-card,.reveal-back{background:#1d3832;color:#d5c196;border:1rpx solid #738067;border-radius:13rpx;box-shadow:0 16rpx 28rpx rgba(35,63,57,.12)}.resting-card:before,.fan-card:before,.reveal-back:before{content:"";position:absolute;inset:10rpx;border:1rpx solid rgba(213,193,150,.4);border-radius:8rpx}.resting-card{position:absolute;left:50%;top:102rpx;width:178rpx;height:270rpx;margin-left:-89rpx;display:flex;align-items:center;justify-content:center;flex-direction:column}.rest-one{transform:rotate(-12deg) translate(-18rpx,7rpx)}.rest-two{transform:rotate(10deg) translate(17rpx,4rpx)}.rest-three{transform:rotate(-1deg)}.rest-three text{font-size:14rpx;letter-spacing:4rpx;margin-top:28rpx}.card-emblem{width:78rpx;height:100rpx;border:1rpx solid rgba(213,193,150,.5);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:42rpx;position:relative}.card-emblem:after{content:"";position:absolute;inset:10rpx -10rpx;border:1rpx solid rgba(213,193,150,.22);border-radius:50%}.fan{position:absolute;inset:0}.fan-anchor{position:absolute;left:50%;top:145rpx;width:156rpx;height:246rpx;margin-left:-78rpx;transform:translate(var(--card-x),var(--card-y)) rotate(var(--card-angle));transform-origin:50% 115%;transition:transform 400ms cubic-bezier(.2,.7,.2,1)}.fan-card{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;transition:transform 300ms ease,box-shadow 300ms ease,opacity 300ms ease}.fan-card.chosen{transform:translateY(-58rpx);box-shadow:0 0 0 2rpx #b59c62,0 20rpx 24rpx rgba(35,63,57,.15);background:#315147}.fan-number{font-size:17rpx;letter-spacing:2rpx;margin-top:34rpx}.dealing .fan-anchor{animation:deal-fan 760ms var(--card-delay) cubic-bezier(.18,.7,.2,1) both}.selection-slots{display:flex;gap:12rpx;margin:0 -4rpx}.selection-slot{flex:1;text-align:center;min-width:0;border:1rpx dashed #cccdbd;border-radius:10rpx;padding:15rpx 3rpx;font-size:19rpx;color:#87907a;line-height:1.8}.selection-slot.filled{border-style:solid;border-color:#9aa68a;background:#eaecdf;color:#3d5846}.slot-number{font-family:Georgia,serif;font-size:22rpx;color:#9a885d}.slot-role{font-size:19rpx}.ritual-caption{font-size:23rpx;line-height:1.8;text-align:center;color:#68765e;margin:26rpx 0 22rpx}.primary-button{justify-content:space-between}.primary-button text{color:#d8c392}.reveal-array{position:absolute;inset:0}.reveal-shell{position:absolute;width:174rpx;height:274rpx;top:150rpx;perspective:1000rpx}.position-0{left:24rpx;transform:rotate(-7deg)}.position-1{left:50%;margin-left:-87rpx;top:79rpx;z-index:2}.position-2{right:24rpx;transform:rotate(7deg)}.reveal-card{position:relative;width:100%;height:100%;transform-style:preserve-3d;animation:ritual-flip 850ms cubic-bezier(.2,.65,.2,1) both}.reveal-back,.reveal-front{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;display:flex;align-items:center;justify-content:center;overflow:hidden}.reveal-back text{font-size:48rpx}.reveal-front{transform:rotateY(180deg);border-radius:13rpx;background:#25453c;border:1rpx solid #ad9b6c;flex-direction:column;color:#efdfb8}.reveal-front image{width:162rpx;height:203rpx}.reveal-front text{font-family:serif;font-size:24rpx;letter-spacing:4rpx}.foil{position:absolute;inset:-50%;background:linear-gradient(110deg,transparent 42%,rgba(255,241,196,.2) 49%,transparent 56%);animation:foil-pass 1600ms 300ms both;pointer-events:none}.array-line{position:absolute;left:80rpx;right:80rpx;top:185rpx;height:205rpx;border:1rpx solid #b6a16c;clip-path:polygon(50% 0,100% 100%,0 100%);opacity:0;animation:line-arrive 500ms 1250ms both}.result-actions{display:flex;gap:14rpx;margin-top:24rpx}.result-actions button{flex:1;font-size:24rpx;padding:24rpx 14rpx}.text-actions{display:flex;justify-content:space-around;margin:8rpx 0 18rpx}.text-actions button,.quiet-action{background:transparent;font-size:23rpx;color:#66745b;padding:20rpx 0;margin:0}.topic-control{margin-top:22rpx;border-top:1rpx solid #dcdecf}.topic-list{display:flex;flex-wrap:wrap;gap:12rpx}.topic-list button{flex:1;font-size:22rpx;padding:16rpx 5rpx;background:#e7e9dc;color:#65745b;border:1rpx solid transparent}.topic-list .selected{border-color:#829273;background:#dfe5d5;color:#2d493a}.inline-error{color:#885b3d;background:#eee6d8;padding:20rpx;font-size:24rpx;line-height:1.7;margin-top:18rpx}.ritual-footnote{text-align:center;color:#7b836e;font-size:20rpx;line-height:1.9;margin-top:26rpx}@keyframes deal-fan{0%{opacity:0;transform:translate(0,-40rpx) rotate(0deg) scale(.92)}30%{opacity:1}100%{opacity:1;transform:translate(var(--card-x),var(--card-y)) rotate(var(--card-angle))}}@keyframes ritual-flip{0%,10%{transform:rotateY(0)}100%{transform:rotateY(180deg)}}@keyframes foil-pass{0%{transform:translateX(-55%)}100%{transform:translateX(55%)}}@keyframes line-arrive{from{opacity:0;transform:scale(.85)}to{opacity:.5;transform:scale(1)}}.reduced .fan-anchor,.reduced .fan-card{animation:none;transition:none}@media(prefers-reduced-motion:reduce){.fan-anchor,.fan-card,.reveal-card,.foil,.array-line{animation:none;transition:none}.reveal-card{transform:rotateY(180deg)}}

.array-line{inset:0;clip-path:none;border:0;transform:none;height:auto;animation:line-arrive 500ms 1250ms both;pointer-events:none}.array-beam{position:absolute;height:1rpx;background:linear-gradient(90deg,transparent,#c8ae72,transparent);transform-origin:left center}.beam-one{left:15%;top:59%;width:37%;transform:rotate(-18deg)}.beam-two{left:50%;top:43%;width:37%;transform:rotate(18deg)}.beam-three{left:15%;top:59%;width:70%}.array-glow{position:absolute;left:50%;top:61%;color:#d5b86e;font-size:26rpx;animation:glow-once 700ms 1200ms both}.slot-back{width:28rpx;height:40rpx;border-radius:3rpx;border:1rpx solid #9b9369;background:#29463a;color:#d4c08f;margin:0 auto 8rpx;line-height:40rpx;font-size:20rpx;animation:slot-land 350ms cubic-bezier(.2,.7,.2,1) both}.reduced .slot-back{animation:none}@keyframes slot-land{from{opacity:0;transform:translateY(-70rpx) scale(1.3)}to{opacity:1;transform:translateY(0) scale(1)}}@keyframes glow-once{0%{opacity:0;transform:translateX(-50%) scale(.4)}60%{opacity:1}100%{opacity:0;transform:translateX(-50%) scale(1.5)}}

.selection-slot{height:180rpx;box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:center}.result-reveal{margin-top:26rpx;animation:result-arrive 550ms ease both}.reduced .result-reveal{animation:none}@keyframes result-arrive{from{opacity:0;transform:translateY(12rpx)}to{opacity:1;transform:translateY(0)}}@media(prefers-reduced-motion:reduce){.result-reveal,.slot-back,.array-glow{animation:none}}

.spread-mode-row{display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #d4dac9;margin:20rpx 0;padding:10rpx 0;font-size:24rpx;color:#405a43}.spread-mode-row button{font-size:24rpx;margin:0;padding:12rpx 0;background:transparent;color:#6b7f60}
