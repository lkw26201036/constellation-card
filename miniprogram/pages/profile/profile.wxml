<view class="page-shell profile-page">
  <view class="eyebrow">我的星图</view>
  <view class="profile-head">
    <view>
      <view class="title">{{selectedSign}}</view>
      <view class="muted">今天也和自己站在一起</view>
    </view>
    <view class="profile-orb">✦</view>
  </view>

  <view class="streak-card">
    <view class="streak-number">{{streak}}</view>
    <view>
      <view class="streak-title">连续访问天数</view>
      <view class="muted">保持一点点好奇，明天见。</view>
    </view>
  </view>

  <view class="profile-stats">
    <view><view class="profile-stat-number">{{favoriteCount}}</view><view class="muted">收藏卡片</view></view>
    <view><view class="profile-stat-number">{{drawCount}}</view><view class="muted">近期抽签记录</view></view>
  </view>

  <view class="settings-list">
    <picker mode="selector" range="{{signNames}}" value="{{selectedIndex}}" bindchange="chooseSign">
      <view class="setting-row"><view>我的星座</view>
      <view class="muted">{{selectedSign}} ›</view></view>
    </picker>
    <view class="setting-row feedback-row">
      <view>问题与建议</view><view class="muted">›</view>
      <button class="feedback-button" open-type="feedback" aria-label="问题与建议"></button>
    </view>
    <view class="setting-row" bindtap="openResearch"><view>本机体验记录</view><view class="muted">可选开启 ›</view></view>
    <view class="setting-row" bindtap="openPrivacy">
      <view>使用与数据说明</view>
      <view class="muted">›</view>
    </view>
  </view>
  <view class="local-note">收藏最多50张，近期记录最多30条。数据保存在当前设备，清理小程序数据可能丢失。</view>
</view>
