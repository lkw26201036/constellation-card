<view class="page-shell profile-page"><view class="eyebrow">我的 · PERSONAL</view><view class="profile-head"><view><view class="latin">{{latin}}</view><view class="title">{{selectedSign || '尚未选择星座'}}</view><view class="date-range">{{dateRange}}</view></view><view class="profile-glyph">{{glyph}}</view></view><view class="profile-stats"><view class="stat"><view class="stat-value">{{streak}}<text class="stat-unit">天</text></view><view class="stat-label">连续访问</view></view><view class="stat" bindtap="openCollection" role="button"><view class="stat-value">{{favoriteCount}}</view><view class="stat-label">收藏卡片 ›</view></view><view class="stat"><view class="stat-value">{{drawCount}}</view><view class="stat-label">近期抽签</view></view></view><button wx:if="{{quizDraft}}" class="resume-quiz" style="width:100%" bindtap="openQuiz"><view><view>继续上次测试</view><view class="resume-note">已回答 {{quizDraft.answers.length}} / 8 道题</view></view><text>→</text></button><view class="settings-heading">使用偏好</view><view class="settings-list"><picker mode="selector" range="{{signNames}}" value="{{selectedIndex}}" bindchange="chooseSign"><view class="setting-row"><view>我的星座</view><view class="setting-value">{{selectedSign}} <text class="row-arrow">›</text></view></view></picker><view class="setting-row" bindtap="openLaunchPreview"><view>启动动效</view><view class="setting-value">预览 <text class="row-arrow">↗</text></view></view><view class="setting-row"><view><view>减少动效</view><view class="setting-caption">简化启动与抽卡动效</view></view><switch color="#536d50" checked="{{reducedMotion}}" bindchange="changeMotion" aria-label="减少动效" /></view></view><view class="settings-heading">关于与反馈</view><view class="settings-list"><view class="setting-row feedback-row"><view>问题与建议</view><text class="row-arrow">›</text><button class="feedback-button" open-type="feedback" aria-label="问题与建议"></button></view><view class="setting-row" bindtap="openResearch"><view>本机体验记录</view><view class="setting-value">可选开启 <text class="row-arrow">›</text></view></view><view class="setting-row" bindtap="openPrivacy"><view>使用与数据说明</view><text class="row-arrow">›</text></view></view><view class="local-note">数据保存在当前设备，清理后无法恢复。<text class="version">V0.8.1 · 星座卡牌</text></view></view>
