.title{font-size:41rpx;font-weight:600;line-height:1.5;letter-spacing:1rpx}.intro,.note{font-size:24rpx;line-height:1.95;color:#65715e;margin-top:24rpx}.switch-row{display:flex;justify-content:space-between;align-items:center;gap:24rpx;padding:26rpx 0;border-top:1rpx solid #d7e0ca;border-bottom:1rpx solid #d7e0ca;margin-top:30rpx;font-size:27rpx}.summary{padding:22rpx 26rpx;background:#e7ebdc;border:1rpx solid #d8e0c9;border-radius:16rpx;margin-top:26rpx;font-size:24rpx;color:#5a6d4c}.summary-line{display:flex;justify-content:space-between;gap:16rpx;line-height:2}.metrics{margin-top:28rpx}.metric{display:flex;justify-content:space-between;gap:22rpx;padding:22rpx 0;border-bottom:1rpx solid #dce3d0;font-size:25rpx;line-height:1.8;color:#4e6548}.metric-value{font-size:29rpx;color:#314f35;font-family:Georgia,serif}.research-action{width:100%;box-sizing:border-box;margin-top:22rpx;font-size:26rpx}

.research-page .primary-button,.research-page .ghost-button{margin-top:24rpx}
