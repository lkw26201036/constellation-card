.home-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 42rpx;
}

.eyebrow {
  color: #a1968c;
  font-size: 23rpx;
  letter-spacing: 1rpx;
  margin-bottom: 14rpx;
}

.title {
  font-size: 44rpx;
  line-height: 1.3;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.sign-picker {
  max-width: 210rpx;
  padding: 14rpx 20rpx;
  background: #fffaf4;
  color: #6a5b52;
  border-radius: 999rpx;
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card {
  box-shadow: 0 22rpx 50rpx rgba(104, 84, 68, 0.12);
}

.hero-card {
  min-height: 500rpx;
  padding: 44rpx 38rpx 36rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #dfe4ec 0%, #c2cedd 48%, #aebdcd 100%);
  color: #3d4852;
  position: relative;
  overflow: hidden;
  transform-origin: center bottom;
}

.hero-card.card-enter {
  animation: card-enter 520ms cubic-bezier(0.2,0.8,0.2,1);
}

.card-glow {
  position: absolute;
  width: 260rpx;
  height: 260rpx;
  right: -80rpx;
  top: -110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
}

.hero-card::after {
  content: "✦";
  position: absolute;
  right: 48rpx;
  top: 36rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 56rpx;
  animation: twinkle 3s ease-in-out infinite;
}

.card-meta {
  position: relative;
  z-index: 1;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  opacity: 0.72;
}

.card-title {
  position: relative;
  z-index: 1;
  font-size: 54rpx;
  line-height: 1.25;
  font-weight: 600;
  margin-top: 112rpx;
  max-width: 520rpx;
}

.card-keyword {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  font-size: 27rpx;
}

.card-summary {
  position: relative;
  z-index: 1;
  margin-top: 26rpx;
  line-height: 1.8;
  font-size: 27rpx;
  max-width: 580rpx;
}

.card-divider {
  height: 1rpx;
  background: rgba(61, 72, 82, 0.18);
  margin: 44rpx 0 24rpx;
}

.card-foot {
  display: flex;
  justify-content: space-between;
  font-size: 23rpx;
  opacity: 0.78;
}

.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin: 28rpx 0 58rpx;
}

.actions .primary-button {
  grid-column: span 2;
}

.button-arrow {
  margin-left: 10rpx;
  font-size: 30rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.tip-card {
  display: flex;
  gap: 18rpx;
  align-items: center;
  background: #fffaf4;
  padding: 28rpx;
  border-radius: 24rpx;
  color: #6e635a;
  line-height: 1.7;
  font-size: 26rpx;
}

.tip-mark {
  color: #b49375;
  font-size: 34rpx;
  animation: float-mark 2.8s ease-in-out infinite;
}

@keyframes card-enter {
  0% { opacity: 0.35; transform: translateY(18rpx) scale(0.97) rotate(-1deg); }
  65% { opacity: 1; transform: translateY(-6rpx) scale(1.01) rotate(0.4deg); }
  100% { transform: translateY(0) scale(1) rotate(0); }
}

@keyframes twinkle {
  0%, 100% { opacity: 0.6; transform: scale(0.9) rotate(0); }
  50% { opacity: 1; transform: scale(1.08) rotate(12deg); }
}

@keyframes float-mark {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

.daily-footnote { margin-top: 28rpx; text-align: center; font-size: 22rpx; color: #8d857d; }
