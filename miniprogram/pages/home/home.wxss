.home-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 42rpx;
}

.eyebrow {
  color: #a1968c;
  font-size: 23rpx;
  letter-spacing: 1rpx;
  margin-bottom: 14rpx;
}

.title {
  font-size: 44rpx;
  line-height: 1.3;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.sign-picker {
  padding: 14rpx 20rpx;
  background: #fffaf4;
  color: #6a5b52;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.card {
  box-shadow: 0 22rpx 50rpx rgba(104, 84, 68, 0.12);
}

.hero-card {
  min-height: 500rpx;
  padding: 44rpx 38rpx 36rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #dfe4ec 0%, #c2cedd 48%, #aebdcd 100%);
  color: #3d4852;
  position: relative;
  overflow: hidden;
}

.hero-card::after {
  content: "✦";
  position: absolute;
  right: 48rpx;
  top: 36rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 56rpx;
}

.card-meta {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  opacity: 0.72;
}

.card-title {
  font-size: 54rpx;
  line-height: 1.25;
  font-weight: 600;
  margin-top: 130rpx;
  max-width: 520rpx;
}

.card-keyword {
  margin-top: 22rpx;
  font-size: 27rpx;
}

.card-summary {
  margin-top: 26rpx;
  line-height: 1.8;
  font-size: 27rpx;
  max-width: 580rpx;
}

.card-divider {
  height: 1rpx;
  background: rgba(61, 72, 82, 0.18);
  margin: 44rpx 0 24rpx;
}

.card-foot {
  display: flex;
  justify-content: space-between;
  font-size: 23rpx;
  opacity: 0.78;
}

.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin: 28rpx 0 58rpx;
}

.actions .primary-button {
  grid-column: span 2;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.tip-card {
  display: flex;
  gap: 18rpx;
  align-items: center;
  background: #fffaf4;
  padding: 28rpx;
  border-radius: 24rpx;
  color: #6e635a;
  line-height: 1.7;
  font-size: 26rpx;
}

.tip-mark {
  color: #b49375;
  font-size: 34rpx;
}
