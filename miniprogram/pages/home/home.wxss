.home-head{display:flex;justify-content:space-between;align-items:center;gap:16rpx;margin-bottom:32rpx}.title{font-size:39rpx;font-weight:600;line-height:1.5;margin-top:10rpx;letter-spacing:1rpx}.sign-picker{display:flex;align-items:center;gap:10rpx;font-size:23rpx;white-space:nowrap;border-bottom:1rpx solid #c8cdbf;padding:14rpx 0 14rpx 8rpx;color:#465a47}.sign-glyph{font-size:27rpx}.chevron{color:#65715e;margin-left:2rpx}.first-note{font-size:23rpx;line-height:1.8;color:#65715e;margin:-8rpx 0 26rpx}.card-wrap{border-radius:24rpx}.card-enter{animation:card-settle 180ms ease-out}@keyframes card-settle{from{opacity:.65}to{opacity:1}}.actions{display:grid;grid-template-columns:1fr 1fr;gap:0 22rpx;margin-top:24rpx}.actions .primary-button{grid-column:span 2;justify-content:space-between;padding-left:30rpx;padding-right:30rpx}.button-arrow{font-size:32rpx;color:#d9c9a5}.secondary-action{margin:0;background:transparent;font-size:24rpx;color:#596551;border-radius:0;min-height:84rpx;border-bottom:1rpx solid #dedfd3;padding:22rpx 6rpx}.daily-action{margin:42rpx 0 48rpx;padding-left:24rpx;border-left:2rpx solid #b5a179}.section-index{font-size:21rpx;letter-spacing:2rpx;color:#65715e}.action-copy{font-size:29rpx;line-height:1.85;margin-top:14rpx;color:#40513f}.section-head{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx;margin:0 0 16rpx}.section-title{font-size:31rpx;font-weight:600}.section-aside{font-size:21rpx;color:#65715e}.explore-list{border-top:1rpx solid #daddcf}.entry-row{display:flex;align-items:center;gap:22rpx;padding:28rpx 0;margin:0;background:transparent;border-bottom:1rpx solid #daddcf;border-radius:0;text-align:left;color:#283c33}.entry-number{font-size:20rpx;letter-spacing:2rpx;color:#92957e}.entry-content{flex:1;min-width:0}.entry-name{font-size:28rpx}.entry-caption{font-size:23rpx;color:#65715e;margin-top:6rpx}.entry-arrow{font-size:33rpx;font-weight:300;color:#65715e}.quiz-entry{background:#e7e7db;border:1rpx solid #d7dacb;color:#364a39;text-align:left;margin-top:36rpx;padding:28rpx;border-radius:20rpx}.quiz-entry-top{display:flex;justify-content:space-between;gap:16rpx;font-size:21rpx;color:#65715e}.quiz-entry-name{display:flex;justify-content:space-between;gap:16rpx;font-size:29rpx;line-height:1.6;margin-top:18rpx}.daily-footnote{margin-top:34rpx;text-align:center;font-size:21rpx;line-height:1.8;color:#65715e}@media(prefers-reduced-motion:reduce){.card-enter{animation:none}}

.ritual-entries{display:flex;gap:16rpx;margin:8rpx 0 42rpx}.ritual-entry{flex:1;min-width:0;position:relative;text-align:left;padding:25rpx 22rpx 120rpx;margin:0;border-radius:15rpx;overflow:hidden;border:1rpx solid #bdc6b0}.spread-entry{background:#243f37;color:#efe3c6}.answer-entry{background:#e9e5d6;color:#374b3b}.entry-kicker{font-size:15rpx;letter-spacing:2rpx;opacity:.7}.ritual-entry-name{font-family:serif;font-size:35rpx;letter-spacing:2rpx;display:flex;justify-content:space-between;margin-top:19rpx}.ritual-entry-name text{font-family:Arial;font-size:25rpx}.ritual-entry-caption{font-size:20rpx;line-height:1.7;margin-top:10rpx;opacity:.75}.entry-fan{position:absolute;bottom:-25rpx;left:50%;width:80rpx;height:110rpx;margin-left:-40rpx}.entry-fan view{position:absolute;width:80rpx;height:110rpx;background:#304c41;border:1rpx solid #ad9d73;border-radius:5rpx;transform:rotate(-23deg) translateX(-30rpx)}.entry-fan view:nth-child(2){transform:rotate(0)}.entry-fan view:nth-child(3){transform:rotate(23deg) translateX(30rpx)}.entry-book{position:absolute;bottom:-20rpx;left:50%;width:92rpx;height:118rpx;line-height:90rpx;text-align:center;margin-left:-46rpx;background:#29463b;color:#d4be91;border:3rpx double #9a956c;border-radius:2rpx 7rpx 7rpx 2rpx;transform:rotate(-10deg);font-size:35rpx}

.connection-entries{margin:-18rpx 0 38rpx;border-top:1rpx solid #d1d8c5}.connection-entries button{display:flex;align-items:center;gap:23rpx;text-align:left;color:#3c563f;background:transparent;border-bottom:1rpx solid #d1d8c5;border-radius:0;padding:25rpx 0;margin:0}.connection-entries button>view{flex:1}.connection-entries button>view>view{font-family:serif;font-size:31rpx;letter-spacing:2rpx}.connection-entries button>view>text{font-size:22rpx;color:#748267}.connection-mark{font-family:serif;font-size:30rpx;color:#a38e61;min-width:66rpx;text-align:center}
