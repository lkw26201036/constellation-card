<view class="page-shell home-page">
  <view class="home-head">
    <view>
      <view class="eyebrow">今日星象 · {{dateLabel}}</view>
      <view class="title">给今天一张温柔的卡</view>
    </view>
    <picker class="sign-picker" mode="selector" range="{{signNames}}" value="{{selectedIndex}}" bindchange="chooseSign">
      <view>{{card.symbol}} {{selectedSign}}⌄</view>
    </picker>
  </view>

  <view bindtap="openDetail" class="card hero-card {{cardAnimating ? 'card-enter' : ''}}">
    <view class="card-glow"></view>
    <view class="card-meta">{{card.sign}} · 今日能量卡</view>
    <view class="card-title">{{card.title}}</view>
    <view class="card-keyword">{{card.keyword}}</view>
    <view class="card-summary">{{card.summary}}</view>
    <view class="card-divider"></view>
    <view class="card-foot">
      <view>幸运色 · {{card.color}}</view>
      <view>幸运数 · {{card.number}}</view>
    </view>
  </view>

  <view class="actions">
    <button class="primary-button" bindtap="openDraw">抽签与自由抽卡 <text class="button-arrow">→</text></button>
    <button class="ghost-button" bindtap="saveCard">{{isFavorite ? '已收藏' : '收藏卡片'}}</button>
    <button class="ghost-button" open-type="share">分享给朋友</button>
  </view>

  <view class="section-head">
    <view class="section-title">今天的小提示</view>
    <view class="muted">{{card.keyword}}</view>
  </view>
  <view class="tip-card">
    <view class="tip-mark">✦</view>
    <view>{{card.tip}}</view>
  </view>
  <button style="width:100%" class="quiz-entry" bindtap="openQuiz"><view class="quiz-label">8道题 · 趣味测试</view><view>你更喜欢哪种充电方式？ →</view></button>
  <view class="daily-footnote">每天更新一张卡 · 本地内容按主题轮换</view>
</view>
