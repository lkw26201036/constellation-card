.weekly-page{background:linear-gradient(180deg,var(--paper) 0%,#eef0e7 58%,var(--paper) 100%)}.weekly-title{font-family:"Songti SC","STSong",serif;font-size:48rpx;line-height:1.55;color:var(--ink);margin-top:18rpx}.weekly-range{font-size:22rpx;color:var(--muted);margin-top:10rpx;letter-spacing:1rpx}.weekly-theme{margin-top:28rpx;padding:28rpx 26rpx;background:var(--forest);color:#f0e5ca;border:1rpx solid #55705a;border-radius:var(--radius-lg);box-shadow:0 16rpx 32rpx rgba(47,76,59,.12)}.theme-kicker{font-size:18rpx;letter-spacing:3rpx;color:#c5b98f}.theme-title{font-family:serif;font-size:38rpx;line-height:1.55;margin-top:24rpx}.theme-line{font-size:24rpx;line-height:1.8;margin-top:10rpx;color:#e0e5d7}.theme-action{margin-top:22rpx;padding-top:18rpx;border-top:1rpx solid rgba(236,220,177,.3);font-size:23rpx;line-height:1.8;color:#ecd8aa}.weekly-stats{display:flex;margin:26rpx 0 38rpx;padding:24rpx 0;border-top:1rpx solid var(--border);border-bottom:1rpx solid var(--border);text-align:center;color:var(--muted);font-size:20rpx}.weekly-stats>view{flex:1;border-right:1rpx solid var(--border)}.weekly-stats>view:last-child{border-right:0}.weekly-stat-value{font-family:Georgia,serif;font-size:42rpx;line-height:1.4;color:var(--ink);margin-bottom:5rpx}.weekly-section-title{font-size:28rpx;font-weight:600;color:var(--ink);margin-bottom:14rpx}.weekly-action{padding:18rpx 0;border-top:1rpx solid var(--border)}.weekly-action-date{font-size:19rpx;letter-spacing:2rpx;color:#8a927f}.weekly-action-title{font-family:serif;font-size:28rpx;line-height:1.6;margin-top:5rpx;color:var(--ink)}.weekly-action .action-followup{margin-top:10rpx}.weekly-empty{text-align:center;padding:38rpx 20rpx;border-top:1rpx solid var(--border);border-bottom:1rpx solid var(--border);color:var(--muted);font-size:25rpx}.empty-symbol{font-size:34rpx;color:var(--gold);margin-bottom:10rpx}.empty-copy{font-size:21rpx;line-height:1.8;margin-top:8rpx}.weekly-links{display:grid;gap:14rpx;margin-top:28rpx}.weekly-links button{width:100%}.weekly-footnote{text-align:center;font-size:20rpx;line-height:1.8;color:#7d886f;margin-top:30rpx}
