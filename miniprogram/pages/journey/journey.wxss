.journey-page{background:linear-gradient(180deg,var(--paper) 0%,#eef0e7 58%,var(--paper) 100%)}.journey-title{font-family:"Songti SC","STSong",serif;font-size:48rpx;line-height:1.55;color:var(--ink);margin-top:18rpx}.journey-intro{text-align:center;margin-top:54rpx;padding:40rpx 24rpx 34rpx;background:rgba(252,251,247,.72);border:1rpx solid var(--border);border-radius:var(--radius-lg)}.journey-symbol{font-size:48rpx;color:var(--gold)}.journey-lead{font-family:serif;font-size:31rpx;line-height:1.7;color:var(--ink);margin-top:18rpx}.journey-copy{font-size:23rpx;line-height:1.8;color:var(--muted);margin-top:10rpx}.journey-start{margin-top:30rpx}.journey-headline{display:flex;justify-content:space-between;align-items:end;gap:16rpx;margin-top:34rpx;padding-bottom:16rpx;border-bottom:1rpx solid var(--border)}.journey-kicker,.journey-complete-kicker{font-size:19rpx;letter-spacing:3rpx;color:#8a927f}.journey-progress{font-family:Georgia,serif;font-size:38rpx;color:var(--ink);margin-top:6rpx}.journey-headline>text{font-size:21rpx;color:var(--muted)}.journey-nodes{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:7rpx;margin:22rpx 0 32rpx}.journey-node{text-align:center;font-size:17rpx;line-height:1.4;color:#9aa08e;min-width:0}.journey-node-dot{width:42rpx;height:42rpx;line-height:42rpx;margin:0 auto 8rpx;border-radius:50%;border:1rpx solid #ccd2c4;font-size:19rpx}.journey-node-done{color:#536d50}.journey-node-done .journey-node-dot{color:#f3ecd9;background:var(--forest);border-color:var(--forest)}.journey-node-available{color:var(--ink)}.journey-node-available .journey-node-dot{color:var(--forest);border:2rpx solid var(--gold);background:#f1e8cf}.journey-card{margin-top:10rpx;padding:30rpx 26rpx;background:var(--forest);color:#efe4c7;border:1rpx solid #55705a;border-radius:var(--radius-lg);box-shadow:0 16rpx 32rpx rgba(47,76,59,.12)}.journey-card-index{font-size:18rpx;letter-spacing:3rpx;color:#c5b98f}.journey-card-title{font-family:serif;font-size:37rpx;line-height:1.55;margin-top:18rpx}.journey-card-text{font-size:25rpx;line-height:1.8;color:#e0e5d7;margin-top:10rpx}.journey-card .action-followup{margin-top:18rpx}.journey-complete-kicker{margin-top:34rpx;margin-bottom:16rpx}.journey-action{margin-top:16rpx}.journey-wait{text-align:center;margin-top:50rpx;padding:45rpx 20rpx;border-top:1rpx solid var(--border);border-bottom:1rpx solid var(--border);color:var(--muted)}.journey-wait-symbol{font-size:37rpx;color:var(--gold);margin-bottom:10rpx}.journey-wait-copy{font-size:22rpx;margin-top:10rpx}.journey-links{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:30rpx}.journey-links button{width:100%;font-size:22rpx}.journey-footnote{text-align:center;font-size:20rpx;line-height:1.8;color:#7d886f;margin-top:32rpx}@media(prefers-reduced-motion:reduce){.journey-card{animation:none}}
