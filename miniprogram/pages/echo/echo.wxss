.echo-page{background:linear-gradient(180deg,var(--paper) 0%,#eef0e7 58%,var(--paper) 100%)}.echo-title{font-family:"Songti SC","STSong",serif;font-size:48rpx;line-height:1.55;color:var(--ink);margin-top:18rpx}.echo-intro{margin-top:18rpx;font-size:24rpx;color:var(--muted)}.echo-note{margin:28rpx 0 24rpx;padding:20rpx 22rpx;background:rgba(252,251,247,.75);border-left:2rpx solid var(--gold);color:#5b6b57;font-size:23rpx;line-height:1.8}.response-list{border-top:1rpx solid var(--border)}.response-option{display:flex;align-items:center;gap:18rpx;width:100%;margin:0;padding:24rpx 0;background:transparent;border-bottom:1rpx solid var(--border);border-radius:0;text-align:left;color:var(--ink)}.response-mark{font-size:18rpx;letter-spacing:2rpx;color:#9a8b69}.response-option>view{flex:1}.response-title{font-family:serif;font-size:30rpx;line-height:1.5}.response-caption{font-size:22rpx;line-height:1.7;color:var(--muted);margin-top:6rpx}.response-option>text{font-size:28rpx;color:var(--gold)}.echo-card{margin:28rpx 0;background:var(--forest);color:#f0e5ca;border:1rpx solid #56705d;border-radius:var(--radius-lg);padding:30rpx 26rpx;box-shadow:0 18rpx 36rpx rgba(47,76,59,.14)}.echo-card-topline{font-size:18rpx;letter-spacing:2rpx;color:#c9c29f}.echo-card-title{font-family:serif;font-size:40rpx;line-height:1.5;margin-top:30rpx;color:#f3e6c4}.echo-card-text{font-size:26rpx;line-height:1.9;margin-top:18rpx;color:#e0e5d7}.echo-card-advice{margin-top:28rpx;padding-top:20rpx;border-top:1rpx solid rgba(236,220,177,.3);font-size:23rpx;line-height:1.8;color:#e9d8ae}.echo-card-advice>view:first-child{font-size:18rpx;letter-spacing:2rpx;color:#c5b98f;margin-bottom:6rpx}.echo-card-footnote{margin-top:28rpx;font-size:19rpx;line-height:1.7;color:#aebca9}.echo-error{margin-top:32rpx;padding:24rpx;background:#efe8db;color:#825e47;font-size:24rpx;line-height:1.8}.echo-footnote{text-align:center;font-size:20rpx;line-height:1.8;color:#7d886f;margin-top:34rpx}
