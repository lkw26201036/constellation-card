page {
  --paper:#f4f2ec; --surface:#fcfbf7; --ink:#283c33; --muted:#65715e; --line:#d9dccf; --forest:#233f39; --gold:#b5a179; --plum:#342c46; --plum-soft:#8a7a9c; --border:#d9dccf;
  --radius-sm:12rpx; --radius-md:16rpx; --radius-lg:24rpx; --space-unit:8rpx; --motion-fast:180ms; --motion-standard:480ms; --motion-ritual:1400ms;
  background:var(--paper); color:var(--ink); font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue",Arial,sans-serif; font-size:28rpx;
}
.page-shell { min-height:100vh; box-sizing:border-box; padding:40rpx 36rpx calc(52rpx + env(safe-area-inset-bottom)); }
button { border:0; line-height:1.5; box-sizing:border-box; font-weight:500; }
button::after { border:0; }
button:active { opacity:.82; }
.primary-button,.ghost-button { width:100%; margin:0; padding:24rpx 28rpx; min-height:92rpx; display:flex; justify-content:center; align-items:center; border-radius:var(--radius-md); font-size:27rpx; box-sizing:border-box; }
.primary-button { background:var(--forest); color:#faf7ec; }
.ghost-button { background:var(--surface); color:var(--ink); border:1rpx solid var(--border); }
.muted { color:var(--muted); }
.eyebrow { font-size:21rpx; letter-spacing:3rpx; line-height:1.7; color:var(--muted); }
button[disabled] { opacity:.55; }
